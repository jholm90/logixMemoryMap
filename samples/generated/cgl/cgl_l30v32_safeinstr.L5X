<Routine Name="Area01" Type="RLL">
<RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Stn0001.In0)XIO(Stn0001.In1)OTE(Stn0001.Out0);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Stn0001.In2)[XIC(Stn0001.Out1),XIC(Stn0001.In3)]XIO(Stn0001.In4)OTE(Stn0001.Out1);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Stn0001.Out1)TON(Stn0001T,?,?);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(Stn0001T.DN)OTE(Stn0001.Out2);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[GRT(Stn0001.Cnt,Stn0001.Sp)OTE(Stn0001.Out3);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text><![CDATA[XIC(Stn0001.In5)ONS(Stn0001.Ons0)ADD(Stn0001.Cnt,1,Stn0001.Cnt);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text><![CDATA[EQU(Stn0001.Cnt,100)OTL(Stn0001.Out4);]]></Text>
