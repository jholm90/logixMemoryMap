<Routines>
<Routine Name="LadderFile" Type="RLL">
<Description>
<![CDATA[Subroutine to Simple_motion. Contains only a timer]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(timer_1.DN)TON(timer_1,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(timer_1.DN)OTE(output);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Simple_Motion" Type="ST">
<Description>
<![CDATA[Program to enable two axes, gear them together, move the master, jump to a subroutine, wait for a timer, repeat the above cycle]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(* All information provided "AS IS" - No Warranty or implied merchantability. ]]>
</Line>
<Line Number="2">
<![CDATA[Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes *)]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[		(* Goal of this routine is to demonstrate a simple motion program.  ]]>
</Line>
<Line Number="9">
<![CDATA[			This program will enable two axes, gear them together and move]]>
</Line>
<Line Number="10">
<![CDATA[	 		 one axis incrementally. Toggling an Input allows the operator]]>
</Line>
<Line Number="11">
<![CDATA[			 to loop back and re-execute the move up to 4 times *)]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[		(* Note the use of the Tag 'State'. By forcing a different value into]]>
</Line>
<Line Number="14">
<![CDATA[			this tag for various instructions it enables the user to direct the ]]>
</Line>
<Line Number="15">
<![CDATA[			program flow and execute instructions only once.  This is handy for ]]>
</Line>
<Line Number="16">
<![CDATA[			developing sequential program execution*)]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[		(*****  Enable Axis_0 and Axis_1 *****)]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[if (input_0 & State = 0) then ]]>
</Line>
<Line Number="23">
<![CDATA[	MSO(Axis_0, Axis_0_MSO); MSO(Axis_1, Axis_1_MSO);]]>
</Line>
<Line Number="24">
<![CDATA[	State [:=] 1;]]>
</Line>
<Line Number="25">
<![CDATA[	counter [:=] .5;]]>
</Line>
<Line Number="26">
<![CDATA[end_if;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[		]]>
</Line>
<Line Number="29">
<![CDATA[	]]>
</Line>
<Line Number="30">
<![CDATA[		(***** Check for servos on and Gear *****)]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[If (Axis_0.ServoActionStatus & Axis_1.ServoActionStatus & State = 1) then]]>
</Line>
<Line Number="33">
<![CDATA[	gear_ratio := counter;]]>
</Line>
<Line Number="34">
<![CDATA[	MAG(Axis_0, Axis_1, Axis0_1_MAG, 1, gear_ratio, 1, 1, Actual, Real, Disabled, 10, 1 );]]>
</Line>
<Line Number="35">
<![CDATA[	State := 2;]]>
</Line>
<Line Number="36">
<![CDATA[end_if;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[		(***** Check if axes are Geared and Move Axis_1 *****)]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[if (Axis_0.GearingStatus & State = 2) then]]>
</Line>
<Line Number="41">
<![CDATA[	MAM(Axis_1, Axis_1_MAM, 1, Move_Distance, Move_Speed, Unitspersec, 50, %ofMaximum, 50, %ofMaximum, 1,100.0,100.0,%ofTime, 0, 0 ,0,None,0,0);]]>
</Line>
<Line Number="42">
<![CDATA[	State := 3;]]>
</Line>
<Line Number="43">
<![CDATA[end_if;]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[		(***** Check if move is complete and axis is in position *****)]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[If (Axis_1_MAM.PC & State = 3) then]]>
</Line>
<Line Number="48">
<![CDATA[	State := 4;]]>
</Line>
<Line Number="49">
<![CDATA[end_if;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[If (Axis_1_MAM.PC & counter = 2 & Axis_1.PositionLockStatus & State = 4) then]]>
</Line>
<Line Number="53">
<![CDATA[	State := 5;]]>
</Line>
<Line Number="54">
<![CDATA[end_if;]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[If (input_1 & State = 4) then]]>
</Line>
<Line Number="57">
<![CDATA[	counter := counter + .5;]]>
</Line>
<Line Number="58">
<![CDATA[	State := 1;				(* This directs the program to loop back and re-enter at State = 1 *)				]]>
</Line>
<Line Number="59">
<![CDATA[end_if;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[If (Axis_0.ActualVelocity = 0 & Axis_1.ActualVelocity = 0 & State = 5) then]]>
</Line>
<Line Number="62">
<![CDATA[	MSF(Axis_0, Axis_0_MSF); MSF(Axis_1, Axis_1_MSF);	(* Turn servo axis off *)]]>
</Line>
<Line Number="63">
<![CDATA[	JSR(LadderFile, 0 );								(* Jump to Ladder program *)											(* Return from Ladder enters here *)]]>
</Line>
<Line Number="64">
<![CDATA[end_if;]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[If timer_1.DN & State = 5 then							(* Wait for timer done then reset ]]>
</Line>
<Line Number="67">
<![CDATA[														(* counter to 0 *)]]>
</Line>
<Line Number="68">
<![CDATA[	State := 0;]]>
</Line>
<Line Number="69">
<![CDATA[	counter := 0;]]>
</Line>
<Line Number="70">
<![CDATA[end_if;]]>
</Line>
<Line Number="71">
<![CDATA[	]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
