<DataValueMember Name="Z" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Rx" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Ry" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Rz" DataType="REAL" Radix="Float" Value="0.0"/>
</Structure>
