 HomePosition="0.0" HomeOffset="0.0" MaximumSpeed="1000.0" MaximumAcceleration="10000.0" MaximumDeceleration="10000.0" ProgrammedStopMode="Fast Stop" MasterInputConfigurationBits="1" MasterPositionFilterBandwidth="0.1" MaximumAccelerationJerk="100000.0" MaximumDecelerationJerk="100000.0" DynamicsConfigurationBits="3"
 InterpolatedPositionConfiguration="16#0000_0002" AxisUpdateSchedule="Base"/>
</Data>
</Tag>
<Tag Name="WorkFrame" TagType="Base" DataType="POSITION_DATA" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[[0,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000
		]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="POSITION_DATA">
<DataValueMember Name="ID" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="X" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Y" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Z" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Rx" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Ry" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="Rz" DataType="REAL" Radix="Float" Value="0.0"/>
</Structure>
</Data>
