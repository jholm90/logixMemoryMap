<Data>07 08</Data>
<Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="2055"/>
</Data>
</Tag>
<Tag Name="_Status_rev_revision" TagType="Base" DataType="DINT" Radix="Decimal">
<Data>08 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="8"/>
</Data>
</Tag>
<Tag Name="_Status_rev_Series" TagType="Base" DataType="INT" Radix="Decimal">
<Data>07 00</Data>
<Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="7"/>
</Data>
</Tag>
<Tag Name="_Status_RS232_error" TagType="Base" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[S:5/14 - Serial Port Error]]>
</Description>
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="_Status_Seconds" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:42 - Processor Clock Seconds]]>
</Description>
<Data>0A 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="10"/>
</Data>
</Tag>
<Tag Name="_Status_sign" TagType="Base" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[S:0/3 - Arithmetic flag, Sign- result is negative]]>
</Description>
<Data>01</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="_Status_Stat" TagType="Base" DataType="BOOL" Radix="Decimal">
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="_Status_taskscan_time" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:3L - Last Scan time for a particular task]]>
</Description>
<Data>BC 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="188"/>
</Data>
</Tag>
<Tag Name="_Status_Task_LastScan" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:43 - Last Scan Time for a Task]]>
</Description>
<Data>BE 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="190"/>
</Data>
</Tag>
<Tag Name="_Status_Task_MaxScan" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Maximum Scan Time for a Task]]>
</Description>
<Data>E9 01 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="489"/>
</Data>
</Tag>
<Tag Name="_Status_Task_rate" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:30 Task Time Setpoint]]>
</Description>
<Data>10 27 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="10000"/>
</Data>
</Tag>
<Tag Name="_Status_Task_Scantime" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:3L - Particular task scan time]]>
</Description>
<Data>BC 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="188"/>
</Data>
</Tag>
<Tag Name="_Status_Task_watchdog" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:3H Task Watchdog testpoint]]>
</Description>
<Data>20 A1 07 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="500000"/>
</Data>
</Tag>
<Tag Name="_Status_test_edits" TagType="Base" DataType="SINT" Radix="Decimal">
<Description>
<![CDATA[Processor Test Edits]]>
</Description>
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="_Status_test_mode" TagType="Base" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[S:1 Processor in TEST Mode]]>
</Description>
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="_Status_time" TagType="Base" DataType="DINT" Dimensions="7" Radix="Decimal">
<Description>
<![CDATA[Status file for Clock & Date]]>
</Description>
<Data>CE 07 00 00 01 00 00 00 03 00 00 00 03 00 00 00 
33 00 00 00 09 00 00 00 FF D6 09 00</Data>
<Data Format="Decorated"><Array DataType="DINT" Dimensions="7" Radix="Decimal">
<Element Index="[0]" Value="1998"/>
<Element Index="[1]" Value="1"/>
<Element Index="[2]" Value="3"/>
<Element Index="[3]" Value="3"/>
<Element Index="[4]" Value="51"/>
<Element Index="[5]" Value="9"/>
<Element Index="[6]" Value="644863"/>
</Array>
</Data>
</Tag>
<Tag Name="_Status_Watchdog_faulted" TagType="Base" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[ Major fault on Watchdog]]>
</Description>
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="_Status_Year" TagType="Base" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[S:37 Processor Clock  Year]]>
</Description>
<Data>CE 07 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="1998"/>
</Data>
</Tag>
<Tag Name="_Status_zero" TagType="Base" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[S:0/2 - Arithmetic flag, zero]]>
</Description>
