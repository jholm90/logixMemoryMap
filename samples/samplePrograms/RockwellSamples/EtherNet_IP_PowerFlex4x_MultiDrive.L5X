<Text>
<![CDATA[XIC(PerformParameterWrite0)MSG(ParameterWRMessage0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
