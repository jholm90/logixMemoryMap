 HomePosition="0.0" HomeOffset="0.0" MaximumSpeed="10.0" MaximumAcceleration="100.0" MaximumDeceleration="100.0" ProgrammedStopMode="Fast Stop" MasterInputConfigurationBits="1" MasterPositionFilterBandwidth="0.1" MaximumAccelerationJerk="3000.0" MaximumDecelerationJerk="3000.0" DynamicsConfigurationBits="3"
 InterpolatedPositionConfiguration="16#0000_0002" AxisUpdateSchedule="Base"/>
