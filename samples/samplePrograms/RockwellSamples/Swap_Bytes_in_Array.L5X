<Data Format="Decorated"><Array DataType="DINT" Dimensions="4" Radix="ASCII">
<Element Index="[0]" Value="&apos;1234&apos;"/>
<Element Index="[1]" Value="&apos;5678&apos;"/>
<Element Index="[2]" Value="&apos;1234&apos;"/>
<Element Index="[3]" Value="&apos;5678&apos;"/>
</Array>
</Data>
</Tag>
<Tag Name="array_bytes_reverse" TagType="Base" DataType="DINT" Dimensions="4" Radix="ASCII">
<Data>31 32 33 34 35 36 37 38 31 32 33 34 35 36 37 38</Data>
