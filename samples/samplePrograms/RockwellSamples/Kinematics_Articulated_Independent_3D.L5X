<Routines>
<Routine Name="aaReadMe" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* This Routine describes how to run the sample project ]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[Step1 -  Move physical axes to start position - See routine -  "Robot_StartPosition"]]>
</Line>
<Line Number="3">
<![CDATA[Step2 -  Start the Transform -  See Routine  - "Transform_Routine"]]>
</Line>
<Line Number="4">
<![CDATA[Step3 -  Begin Application -  See Routine - "Application Routine"]]>
</Line>
<Line Number="5">
<![CDATA[Step4 -  Run Trend ]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[*) ]]>
</Line>
</STContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  -- No warranty or implied merchantability.
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Transform_Routine,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Robot_StartPosition,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(PickAndPlace_Routine,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PickAndPlace_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Go to start position
]]>
</Comment>
<Text>
<![CDATA[XIC(Begin_Application)EQU(step,0)[MCLM(CS_Source,mc_word[0],0,pos[0,0],cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[0].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Go to Pick position
]]>
</Comment>
<Text>
<![CDATA[EQU(step,1)[MCLM(CS_Source,mc_word[1],0,pos[1,0],cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[1].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Quarter Circle move  away from 
pick position
]]>
</Comment>
<Text>
<![CDATA[EQU(step,2)[MCCM(CS_Source,mc_word[2],0,pos[2,0],Center,CenterVia_points[2,0],CW,cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[2].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Linear Move to Drop Position
]]>
</Comment>
<Text>
<![CDATA[EQU(step,3)[MCLM(CS_Source,mc_word[3],0,pos[3,0],cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[3].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Circle move to drop position
]]>
</Comment>
<Text>
<![CDATA[EQU(step,4)[MCCM(CS_Source,mc_word[4],0,pos[4,0],Center,CenterVia_points[4,0],CW,cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[4].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Reverse Cycle
]]>
</Comment>
<Text>
<![CDATA[EQU(step,5)[MCCM(CS_Source,mc_word[5],0,pos[5,0],Center,CenterVia_points[4,0],CW,cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[5].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Linear Move to Pick position
]]>
</Comment>
<Text>
<![CDATA[EQU(step,6)[MCLM(CS_Source,mc_word[6],0,pos[6,0],cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,S-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[6].PC) ADD(1,step,step) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Go to Pick Position and Repeat Cycle
]]>
</Comment>
<Text>
<![CDATA[EQU(step,7)[MCCM(CS_Source,mc_word[7],0,pos[7,0],Center,CenterVia_points[7,0],CW,cartspeed,Units per sec,cartacc,Units per sec2,cartdec,Units per sec2,s-Curve,100.0,100.0,% of Time,1,Disabled,Programmed,0,0,None,0,0) ,XIC(mc_word[7].PC) MOV(2,step) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Robot_StartPosition" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Go_ToStartPosition)[MAM(Physical_Joint_1,mc_initialposition[0],0,-26,20.0,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,1000,1000,Units per sec3,Disabled,Programmed,0,None,0,0) ,MAM(Physical_Joint_2,mc_initialposition[1],0,80,20.0,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,1000,1000,Units per sec3,Disabled,Programmed,0,None,0,0) ,MAM(Physical_Joint_3,mc_initialposition[2],0,-80,20.0,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,1000,1000,Units per sec3,Disabled,Programmed,0,None,0,0) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(mc_initialposition[0].PC)XIC(mc_initialposition[1].PC)XIC(mc_initialposition[2].PC)OTU(Go_ToStartPosition);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Transform_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Enable transform and once enabled as indicated by the  status,
  the trigger bit  is disabled
]]>
</Comment>
<Text>
<![CDATA[XIC(Transform_Start)[MCT(CS_Source,CS_3D_Artindep_Target,mct1,ort[0],trs[0]) ,XIC(mct1.IP) OTU(Transform_Start) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Transform Stop Rung
]]>
</Comment>
<Text>
<![CDATA[XIC(Transform_Stop1)[MCS(CS_3D_Artindep_Target,mc_transformStop,Coordinated Transform,No,100,Units per sec2,Yes,100.0,% of Time) ,XIC(mc_transformStop.PC) OTU(Transform_Stop1) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Please Note:  a Motion Axis stop  will also
stop the transform
]]>
</Comment>
<Text>
<![CDATA[XIC(Transform_Stop2)[MAS(Physical_Joint_1,mc_transformStop2,All,No,100,Units per sec2,No,1000,Units per sec3) ,XIC(mc_transformStop2.PC) OTU(Transform_Stop2) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
