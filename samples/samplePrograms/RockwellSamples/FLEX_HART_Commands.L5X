<Rung Number="4" Type="N">
<Text>
<![CDATA[GRT(Send_HART_SF_data.Slot,7)NEQ(Send_HART_SF_data.Slot,20)MOV(65535,Send_HART_SF_Status)JMP(Send_SF_Error_Exit);]]>
