<Text>
<![CDATA[XIC(Timer_9.DN)[MOV(-3,HART_Init_Status.Error_Code) ,OTU(HART_Init_Status.Started) ,OTU(HART_Init_Status.Done) ,OTL(HART_Init_Status.Error) ]JMP(Hart_Init_Return);]]>
