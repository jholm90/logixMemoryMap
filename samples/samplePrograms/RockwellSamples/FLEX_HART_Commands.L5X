<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  -- No warranty or implied merchantability.
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[The S:FS bit Starts the initialization when the system goes into the run mode.
]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[OTU(Send_HART_SF_Flags.Started) ,OTU(HART_Init_Status.Done) ,RES(HART_Error_Counter) ,MOV(1,Send_HART_SF_Handle) ,RES(Counter1) ,RES(Counter2) ,RES(Counter3) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[This rung sets the path, module and the channel that is to be initialized.]]>
</Comment>
<Text>
<![CDATA[XIO(HART_Init_Status.Done)[CONCAT(Send_HART_SF_Empty_STRING,NODE_5_Path,HART_Initialize.Path) ,MOV(2,HART_Initialize.Slot) ,MOV(0,HART_Initialize.Channels) ,MOV(2,HART_Initialize.Group) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[This rung jumps to the initialization routine]]>
</Comment>
<Text>
<![CDATA[XIO(HART_Init_Status.Done)JSR(HART_initialize,1,HART_Initialize,HART_Init_Status);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(HART_Init_Status.Done)CONCAT(Send_HART_SF_Empty_STRING,NODE_5_Path,HART_Initialize.Path);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[This rung sets the path, module and channel that data will be read from and written to.]]>
</Comment>
<Text>
<![CDATA[XIC(HART_Init_Status.Done)[CONCAT(Send_HART_SF_Empty_STRING,NODE_5_Path,HART_Target.Path) ,MOV(2,HART_Target.Slot) ,MOV(1,HART_Target.Channel) ,MOV(2,HART_Target.Host_Group) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[These rungs read the data from the HART_Cmd and jumps to the proper routine to execute that command.
]]>
</Comment>
<Text>
<![CDATA[XIC(HART_Init_Status.Done)EQU(HART_Cmd,0)JSR(HART_CMD_0,1,HART_Target,CMD0_Reply,CMD0_Status);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(HART_Init_Status.Done)EQU(HART_Cmd,1)JSR(HART_CMD_1,1,HART_Target,CMD1_Reply,CMD1_Status);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HART_Init_Status.Done)EQU(HART_Cmd,3)JSR(HART_CMD_3,1,HART_Target,CMD3_Reply,CMD3_Status);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(HART_Init_Status.Done)EQU(HART_Cmd,15)JSR(HART_CMD_15,1,HART_Target,CMD15_reply,CMD15_Status);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(HART_Init_Status.Done)EQU(HART_Cmd,35)JSR(HART_CMD_35,1,HART_Target,CMD35_reply,CMD35_Status);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(S:FS)[RES(Counter1) ,RES(Counter2) ,RES(Counter3) ,RES(Counter4) ,RES(Counter5) ,RES(HART_Error_Counter) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(CMD0_Status.Done)CTU(Counter1,?,?)OTU(CMD0_Status.Done);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(CMD1_Status.Done)CTU(Counter2,?,?)OTU(CMD1_Status.Done);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(CMD3_Status.Done)CTU(Counter3,?,?)OTU(CMD3_Status.Done);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(CMD15_Status.Done)CTU(Counter4,?,?)OTU(CMD15_Status.Done);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(CMD35_Status.Done)CTU(Counter5,?,?)OTU(CMD35_Status.Done);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(CMD0_Status.Error) ,XIC(CMD1_Status.Error) ,XIC(CMD3_Status.Error) ,XIC(CMD15_Status.Error) ,XIC(CMD35_Status.Error) ]CTU(HART_Error_Counter,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="purge" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[SBR(Send_HART_SF_data.Host_Group)MOV(107,Purge_Attr);]]>
