<Text>
<![CDATA[XIC(Msg7.DN)XIC(Timer_3.DN)[EQU(Msg7.DN_LEN,8) XIO(HART_Input_Status[0].7) CPT(HART_Init_Status.HART_Channels_Found,HART_Input_Status[7] AND 255) ,EQU(Msg7.DN_LEN,10) XIO(HART_Input_Status[4].7) CPT(HART_Init_Status.HART_Channels_Found,HART_Input_Status[9] AND 255) ][OTL(HART_Init_Status.Done) ,OTU(HART_Init_Status.Started) ,OTU(HART_Init_Status.Error) ];]]>
