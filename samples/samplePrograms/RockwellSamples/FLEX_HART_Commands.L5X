</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(Send_HART_SF_Calc)[MOV(116,Send_HART_SF_Target_Attribute) ,MOV(8,Send_HART_SF_msg_Size) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(Send_HART_SF_Calc)GRT(Send_HART_SF_data.Data_Size,2)[MOV(115,Send_HART_SF_Target_Attribute) ,MOV(12,Send_HART_SF_msg_Size) ];]]>
</Text>
</Rung>
