<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(Send_HART_SF_Calc)NEQ(Send_HART_SF_data.Slot,20)ADD(Send_HART_SF_data.Slot,1,Send_HART_SF_msg.Instance);]]>
