</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(Send_HART_SF_Calc)NEQ(Send_HART_SF_data.Host_Group,2)NEQ(Send_HART_SF_data.Host_Group,1)MOV(65533,Send_HART_SF_Status)JMP(Send_SF_Error_Exit);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Send_HART_SF_Calc)MOV(0,Send_HART_SF_Offset);]]>
