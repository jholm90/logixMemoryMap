<![CDATA[SBR(HART_Initialize)XIO(HART_Init_Status.Started)[RES(Timer_9) ,RES(Timer_5) ,RES(Timer_6) ,RES(Timer_3) ,MOV(0,HART_Init_Status.Error_Code) ,MOV(0,HART_Init_Status.HART_Channels_Found) ,OTL(HART_Init_Status.Started) ,OTU(HART_Init_Status.Done) ,OTU(HART_Init_Status.Error) ,OTU(Msg1.DN) ,OTU(Msg1.ER) ,OTU(Msg2.DN) ,OTU(Msg2.ER) ,OTU(Msg9.DN) ,OTU(Msg9.ER) ,OTU(Msg7.DN) ,OTU(Msg7.ER) ,OTL(HART_Input_Status[4].7) ];]]>
