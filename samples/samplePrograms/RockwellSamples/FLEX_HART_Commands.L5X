<Rung Number="0" Type="N">
<Text>
<![CDATA[SBR(Send_HART_SF_data)XIO(Send_HART_SF_Flags.Started)[OTU(Send_HART_SF_Calc) ,OTL(Send_HART_SF_Flags.Started) ,OTU(Send_HART_SF_Flags.Done) ,OTU(Send_HART_SF_Flags.Error) ];]]>
