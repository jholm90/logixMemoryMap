<Tag Name="MCTPO_Output" TagType="Base" DataType="REAL" Dimensions="6" Radix="Float">
<Data>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00</Data>
<Data Format="Decorated"><Array DataType="REAL" Dimensions="6" Radix="Float">
<Element Index="[0]" Value="0.0"/>
<Element Index="[1]" Value="0.0"/>
<Element Index="[2]" Value="0.0"/>
<Element Index="[3]" Value="0.0"/>
<Element Index="[4]" Value="0.0"/>
<Element Index="[5]" Value="0.0"/>
</Array>
</Data>
</Tag>
<Tag Name="Robot_Config" TagType="Base" DataType="DINT" Radix="Decimal">
<Data>00 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Start_Conveyor" TagType="Base" DataType="BOOL" Radix="Decimal">
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Start_MCTO" TagType="Base" DataType="BOOL" Radix="Decimal">
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Start_Pick_n_Place" TagType="Base" DataType="BOOL" Radix="Decimal">
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="step" TagType="Base" DataType="DINT" Radix="Decimal">
<Data>00 00 00 00</Data>
<Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Stop_Program" TagType="Base" DataType="BOOL" Radix="Decimal">
<Data>00</Data>
<Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Tool_Index" TagType="Base" DataType="DINT" Radix="Decimal">
