<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="BSEL" Revision="1.0" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2006-09-06T12:45:54.779Z" CreatedBy="NA\Rockwell" EditedDate="2006-12-06T20:01:30.952Z" EditedBy="NA\Rockwell" SoftwareRevision="v16.00"
>
<Description>
<![CDATA[Instruction to select one of N (8 max) boolean inputs]]>
</Description>
<AdditionalHelpText>
<![CDATA[Instruction to reproduce one of eight possible boolean inputs at its output.  The selection is made by a placing the number of the desired boolean in the 'Select' input DINT (1 through 8).
Any value outside of the valid 'Select' range will generate an 'OutOfRange' fault (asserting that boolean output) and will clear the instruction output.
If this instruction is used in Ladder Logic, if the rung condition is false then the instruction will always clear the output.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="In1" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Boolean Input 1]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In2" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Boolean Input 2]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In3" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 3]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In4" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 4]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In5" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 5]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In6" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 6]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In7" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 7]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="In8" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Boolean Input 8]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Select" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[DINT to specify the input to allow 1-8]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Boolean Output]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="OutOfRange" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Select value is out of range 
1>Select>8]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="EnableInFalse" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[Out:=0;]]>
</Line>
<Line Number="3">
<![CDATA[If Select<1 OR Select>8 Then]]>
</Line>
<Line Number="4">
<![CDATA[	OutOfRange:=1;]]>
</Line>
<Line Number="5">
<![CDATA[Else]]>
</Line>
<Line Number="6">
<![CDATA[	OutOfRange:=0;]]>
</Line>
<Line Number="7">
<![CDATA[End_If;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[	]]>
</Line>
<Line Number="3">
<![CDATA[	Case Select OF]]>
</Line>
<Line Number="4">
<![CDATA[		1: Out:=In1;]]>
</Line>
<Line Number="5">
<![CDATA[		2: Out:=In2;]]>
</Line>
<Line Number="6">
<![CDATA[		3: Out:=In3;]]>
</Line>
<Line Number="7">
<![CDATA[		4: Out:=In4;]]>
</Line>
<Line Number="8">
<![CDATA[		5: Out:=In5;]]>
</Line>
<Line Number="9">
<![CDATA[		6: Out:=In6;]]>
</Line>
<Line Number="10">
<![CDATA[		7: Out:=In7;]]>
</Line>
<Line Number="11">
<![CDATA[		8: Out:=In8;]]>
</Line>
<Line Number="12">
<![CDATA[	Else]]>
</Line>
<Line Number="13">
<![CDATA[		Out:=0;]]>
</Line>
<Line Number="14">
<![CDATA[	END_CASE;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[	If Select<1 OR Select>8 Then]]>
</Line>
<Line Number="17">
<![CDATA[		OutOfRange:=1;]]>
</Line>
<Line Number="18">
<![CDATA[	Else]]>
</Line>
<Line Number="19">
<![CDATA[		OutOfRange:=0;]]>
</Line>
<Line Number="20">
<![CDATA[	End_If;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="DeltaT" Revision="1.0" RevisionExtension="V16 Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2006-08-02T23:58:37.283Z" CreatedBy="NA\Rockwell" EditedDate="2006-08-03T00:54:59.726Z" EditedBy="NA\Rockwell"
 SoftwareRevision="v16.00">
<Description>
<![CDATA[Time since last scan]]>
</Description>
<RevisionNote>
<![CDATA[Example for RSLogix 5000 V16]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="DeltaT" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true">
<Description>
<![CDATA[Time in Seconds since previous scan]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="LastTS" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Low-order 31 bits of Timestamp from Last Scan]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="CurrentTS" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Timestamp this scan (from WALLCLOCKTIME)]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><Array DataType="DINT" Dimensions="2" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="DeltaT_Microseconds" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Difference between Last Scan timestamp and Current Scan timestamp (in uSec)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[====================================================================================
DeltaT:  Delta Time Since Last Scan:

Returns the time in Seconds (REAL) between the previous scan of this instruction and this scan.

====================================================================================

This rung gets the current time from the WALLCLOCKTIME object, masks off the
low-order 30 bits, finds the difference from previous scan's stored value,
and stores this scan's value for use next scan.

Note that the DeltaT_Microseconds value will have bits 31 and 30 set
(be a BIG negative number!) if the controller clock's low-order
microseconds wrapped around zero during this last scan.
We mask off those bits in the next rung to get a valid difference.

Since we use only 30 bits of the clock time, this instruction can report
a valid scan time for scans up to just over 2**30 (about a gig) microseconds,
or just over 1000 seconds.  Probably good enough for a typical
ControlLogix application......]]>
</Comment>
<Text>
<![CDATA[GSV(WALLCLOCKTIME,,CurrentValue,CurrentTS[0])AND(CurrentTS[0],16#3fff_ffff,CurrentTS[0])SUB(CurrentTS[0],LastTS,DeltaT_Microseconds)MOV(CurrentTS[0],LastTS);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[After clearing the top two bits of the difference, we have a number
between 0 and 2**30 (about a billion).

Multiply by 10**-6 (divide by a million)
to get from microseconds to seconds for the output (REAL seconds).]]>
</Comment>
<Text>
<![CDATA[OTU(DeltaT_Microseconds.31)OTU(DeltaT_Microseconds.30)MUL(DeltaT_Microseconds,0.000001,DeltaT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="InsertionSortDINT" Revision="1.0" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2006-09-06T12:06:59.831Z" CreatedBy="NA\Rockwell" EditedDate="2006-12-06T20:16:38.608Z" EditedBy="NA\Rockwell" SoftwareRevision="v16.00"
>
<Description>
<![CDATA[Instruction to perform an insertion sort on an array  of DINTs (100 element max).]]>
</Description>
<AdditionalHelpText>
<![CDATA[Instruction to perform an insertion sort on an array  of DINTs (100 element max).
The array designated in the 'DataArray' InOut parameter must be 100 elements in length.  The array size may be modified in the corresponding Data Type field.
The number of consequtive array elements to sort is entered into the 'HowMany' parameter.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="DataArray" DataType="DINT" Dimensions="100" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[DINT array of data to sort (100 element max)]]>
</Description>
</Parameter>
<Parameter Name="HowMany" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Number of elements in the array to sort]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="j" DataType="DINT" Radix="Decimal">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="i" DataType="DINT" Radix="Decimal">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="temp" DataType="DINT" Radix="Decimal">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[FOR i := 1 TO HowMany - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	temp := DataArray[i];]]>
</Line>
<Line Number="3">
<![CDATA[	FOR j := i TO 1 BY -1 DO]]>
</Line>
<Line Number="4">
<![CDATA[		IF (DataArray[j-1] > temp) THEN]]>
</Line>
<Line Number="5">
<![CDATA[			DataArray[j] := DataArray[j-1];]]>
</Line>
<Line Number="6">
<![CDATA[		ELSE]]>
</Line>
<Line Number="7">
<![CDATA[			Exit;]]>
</Line>
<Line Number="8">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="10">
<![CDATA[	DataArray[j] := temp;]]>
</Line>
<Line Number="11">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="InsertionSortReal" Revision="1.0" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2006-09-06T12:19:05.094Z" CreatedBy="NA\Rockwell" EditedDate="2006-12-06T20:17:28.795Z" EditedBy="NA\Rockwell" SoftwareRevision="v16.00"
>
