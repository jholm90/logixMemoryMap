<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false">
<Tags/>
<Routines>
<Routine Name="DateTime_Examples_LD" Type="RLL">
<Description>
<![CDATA[Ladder Diagram routine to test Date/Time (T_xxx) instructions]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[T_Clock(ControllerClock,ControllerTime);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(TestTimer.DN) TON(TestTimer,?,?) ,[XIC(TestTimer.DN) ,XIC(S:FS) ] T_Scan(ScanTimeCalc) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[T_Now(GetTime,Now);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[COP(Now,Noon,1)MOV(12,Noon.Hr)CLR(Noon.Min)CLR(Noon.Sec)CLR(Noon.uSec);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[T_LES(TestAM,Now,Noon)OTE(AM);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[T_GEQ(TestPM,Now,Noon)OTE(PM);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Open up this instruction and enter your Latitude, Longitude and UTC offset.
Then it can calculate sunrise / sunset and solar angles for your location.]]>
</Comment>
<Text>
<![CDATA[T_Sun(SunCalcs,Now,Sunrise,Sunset);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[T_DIFF(HowMuchDaylight,Sunset,Sunrise,LengthOfDay);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[T_LIM(IsDaytime,Sunrise,Now,Sunset) ,XIC(SunCalcs.Sts_MidnightSun) ]XIO(SunCalcs.Sts_NoonNight)OTE(Daytime);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[For the following instructions, enter any date and time into TestDateTime.
You can see if that date/time exists on the calendar (check Feb. 29th....),
the day of the week for that date, and get that date/time put in a STRING.]]>
</Comment>
<Text>
<![CDATA[T_Valid(ValidDateTime,TestDateTime);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[T_DoW(DayOfWeek,TestDateTime);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[T_TtoS(TimeToString,TestDateTime,DateTimeString);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[When will you retire?  Enter your birthdate into Birthdate (year, month, day).
We'lll calculate your 65th birthday, then tell you how many days away that is!]]>
</Comment>
<Text>
<![CDATA[T_ADD(When_will_I_be_65,Birthdate,SixtyFiveYears,Birthday_65)T_DIFF(When_will_I_retire,Birthday_65,Now,DaysTilRetirement);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  -- No warranty or implied merchantability.
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes.
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[====================================================================================

THIS PROJECT PROVIDES A NUMBER OF INSTRUCTIONS WHICH IMPLEMENT THE
IEC-61131-3 DATE_AND_TIME (DT) AND TIME DATA TYPES AND THEIR RELATED
DATE/TIME MATH FUNCTIONS

====================================================================================

The following JSRs jump to a test routine which exercises each of the Time Add-On Instructions.

]]>
</Comment>
<Text>
<![CDATA[JSR(DateTime_Examples_LD,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
