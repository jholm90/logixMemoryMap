</Description>
<DefaultData>06 00 00 00 53 75 6E 64 61 79 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 06 00 00 00 4D 6F 6E 64 
61 79 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
07 00 00 00 54 75 65 73 64 61 79 00 00 00 00 00 
00 00 00 00 00 00 00 00 09 00 00 00 57 65 64 6E 
65 73 64 61 79 00 00 00 00 00 00 00 00 00 00 00 
08 00 00 00 54 68 75 72 73 64 61 79 00 00 00 00 
00 00 00 00 00 00 00 00 06 00 00 00 46 72 69 64 
61 79 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
08 00 00 00 53 61 74 75 72 64 61 79 00 00 00 00 
00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="6">
<![CDATA['Sunday']]>
</DefaultData>
</LocalTag>
<LocalTag Name="DoW" DataType="T_DoW">
<Description>
<![CDATA[AOI to get Day of the Week for given Date]]>
</Description>
<DefaultData>01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><Structure DataType="T_DoW">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="Out" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Sts_InvDate" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_AMString" DataType="STRING_8">
<Description>
<![CDATA[Morning time string]]>
</Description>
<DefaultData>04 00 00 00 61 2E 6D 2E 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="4">
<![CDATA['a.m.']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_PMString" DataType="STRING_8">
<Description>
<![CDATA[Afternoon time string]]>
</Description>
<DefaultData>04 00 00 00 70 2E 6D 2E 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="4">
<![CDATA['p.m.']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_BadDateString" DataType="STRING_20">
<Description>
<![CDATA[Invalid Date String]]>
</Description>
<DefaultData>0F 00 00 00 3C 49 6E 76 61 6C 69 64 20 44 61 74 
65 21 3E 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="15">
<![CDATA['<Invalid Date!>']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_BadTimeString" DataType="STRING_20">
<Description>
<![CDATA[Invalid Time String]]>
</Description>
<DefaultData>0F 00 00 00 3C 49 6E 76 61 6C 69 64 20 54 69 6D 
65 21 3E 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="15">
<![CDATA['<Invalid Time!>']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_DateString" DataType="STRING">
<Description>
<![CDATA[Date Building String]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_TimeString" DataType="STRING">
<Description>
<![CDATA[Time Building String]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_NullString" DataType="STRING">
<Description>
<![CDATA[Empty String for initialization]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_Space" DataType="STRING_8">
<Description>
<![CDATA[String containing one blank space]]>
</Description>
<DefaultData>01 00 00 00 20 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA[' ']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_Colon" DataType="STRING_8">
<Description>
<![CDATA[String containing a colon () character]]>
</Description>
<DefaultData>01 00 00 00 3A 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA[':']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_CommaSpace" DataType="STRING_8">
<Description>
<![CDATA[String containing a comma and following space]]>
</Description>
<DefaultData>02 00 00 00 2C 20 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="2">
<![CDATA[', ']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_Hyphen" DataType="STRING_8">
<DefaultData>01 00 00 00 2D 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA['-']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Digit" DataType="STRING_8">
<Description>
<![CDATA[Small string for building a single digit only]]>
</Description>
<DefaultData>01 00 00 00 30 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA['0']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_YearString" DataType="STRING_20">
<Description>
<![CDATA[Year as STRING for display]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_Period" DataType="STRING_8">
<DefaultData>01 00 00 00 2E 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="1">
<![CDATA['.']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Hour" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Hour 1 to 12 for 12-hour time]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Convert given date and time to formatted text string]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// T_TtoS : Date/Time to STRING (give date as printable string)]]>
</Line>
<Line Number="1">
<![CDATA[// ]]>
</Line>
<Line Number="2">
<![CDATA[// This instruction takes the given date and formats it as a human-readable STRING.  For example,]]>
</Line>
<Line Number="3">
<![CDATA[// for the Date/Time:]]>
</Line>
<Line Number="4">
<![CDATA[//		2008  12  31  23  59  59  999999]]>
</Line>
<Line Number="5">
<![CDATA[// the return STRING will be:]]>
</Line>
<Line Number="6">
<![CDATA[//      Wednesady, December 31, 2008  11:59:59.999999 p.m.]]>
</Line>
<Line Number="7">
<![CDATA[//]]>
</Line>
<Line Number="8">
<![CDATA[// Options are provided for returning the time in 24- or 12-hour format (with a.m. or p.m. indicator on the 12-hour format)]]>
</Line>
<Line Number="9">
<![CDATA[// and for including the microseconds, seconds, Day of the Week, or just an ISO-date format.]]>
</Line>
<Line Number="10">
<![CDATA[//]]>
</Line>
<Line Number="11">
<![CDATA[// This instruction checks for a valid (Gregorian) Date and Time and returns "Invalid Date" and/or "Invalid Time" as appropriate.]]>
</Line>
<Line Number="12">
<![CDATA[//   *  0 <= Microseconds < 1,000,000]]>
</Line>
<Line Number="13">
<![CDATA[//   *  0 <= Seconds < 60]]>
</Line>
<Line Number="14">
<![CDATA[//   *  0 <= Minutes < 60]]>
</Line>
<Line Number="15">
<![CDATA[//   *  0 <= Hours < 24]]>
</Line>
<Line Number="16">
<![CDATA[//   *  0 <= Days <= 31 and a valid Gregorian Date (Feb = 28 or 29 days, etc.)]]>
</Line>
<Line Number="17">
<![CDATA[//   *  1 <= Month <= 12]]>
</Line>
<Line Number="18">
<![CDATA[//   *  year in the range +/- 5879600]]>
</Line>
<Line Number="19">
<![CDATA[//]]>
</Line>
<Line Number="20">
<![CDATA[//  NOTE:  For algorithms used for Gregorian Date validity checking, see http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html]]>
</Line>
<Line Number="21">
<![CDATA[//]]>
</Line>
<Line Number="22">
<![CDATA[//  Revision 1.0-Example:  2008-Jul-02, DER]]>
</Line>
<Line Number="23">
<![CDATA[//	Release for V17 CD as Date/Time Examples]]>
</Line>
<Line Number="24">
<![CDATA[//]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[// INITIALIZE the working strings for building the date and time]]>
</Line>
<Line Number="27">
<![CDATA[COP (Wrk_NullString, Wrk_DateString, 1);]]>
</Line>
<Line Number="28">
<![CDATA[COP (Wrk_NullString, Wrk_TimeString, 1);]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[// Get the Day of the Week for the given Date.  This also does a validity check on the date!]]>
</Line>
<Line Number="31">
<![CDATA[T_DoW (DoW, Ref_DT);]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[// If the Date is invalid, copy the bad date string and flag it]]>
</Line>
<Line Number="34">
<![CDATA[If (DoW.Sts_InvDate) Then]]>
</Line>
<Line Number="35">
<![CDATA[	CONCAT (Wrk_DateString, Cfg_BadDateString, Wrk_DateString);]]>
</Line>
<Line Number="36">
<![CDATA[	Sts_InvDate := 1;]]>
</Line>
<Line Number="37">
<![CDATA[Else]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[// Date is valid, do we want ISO-date (YYYY-MM-DD) or pretty date?]]>
</Line>
<Line Number="40">
<![CDATA[	Sts_InvDate := 0;]]>
</Line>
<Line Number="41">
<![CDATA[	If (Cfg_ISODate) Then]]>
</Line>
<Line Number="42">
<![CDATA[		DTOS (Ref_DT.Yr, Wrk_YearString);]]>
</Line>
<Line Number="43">
<![CDATA[		CONCAT (Wrk_YearString, Cfg_Hyphen, Wrk_DateString);]]>
</Line>
<Line Number="44">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Mo / 10)+48;]]>
</Line>
<Line Number="45">
<![CDATA[		CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="46">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Mo MOD 10)+48;]]>
</Line>
<Line Number="47">
<![CDATA[		CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="48">
<![CDATA[		CONCAT (Wrk_DateString, Cfg_Hyphen, Wrk_DateString);]]>
</Line>
<Line Number="49">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Da / 10)+48;]]>
</Line>
<Line Number="50">
<![CDATA[		CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="51">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Da MOD 10)+48;]]>
</Line>
<Line Number="52">
<![CDATA[		CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="53">
<![CDATA[	Else]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[// Pretty date: first, do we include Day (of the week) name?]]>
</Line>
<Line Number="56">
<![CDATA[		If (Cfg_InclDoW) Then]]>
</Line>
<Line Number="57">
<![CDATA[			If (Cfg_DayFirst) Then]]>
</Line>
<Line Number="58">
<![CDATA[				CONCAT (Cfg_DayNames[DoW.Out],Cfg_Space,Wrk_DateString);]]>
</Line>
<Line Number="59">
<![CDATA[			Else]]>
</Line>
<Line Number="60">
<![CDATA[				CONCAT (Cfg_DayNames[DoW.Out],Cfg_CommaSpace,Wrk_DateString);]]>
</Line>
<Line Number="61">
<![CDATA[			End_If;]]>
</Line>
<Line Number="62">
<![CDATA[		End_If;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[// Next, is the day number first or the month name?]]>
</Line>
<Line Number="65">
<![CDATA[		If (Cfg_DayFirst) Then]]>
</Line>
<Line Number="66">
<![CDATA[			If (Ref_DT.Da > 9) Then]]>
</Line>
<Line Number="67">
<![CDATA[				Wrk_Digit.DATA[0] := (Ref_DT.Da / 10)+48;]]>
</Line>
<Line Number="68">
<![CDATA[				CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="69">
<![CDATA[			End_If;]]>
</Line>
<Line Number="70">
<![CDATA[			Wrk_Digit.DATA[0] := (Ref_DT.Da MOD 10)+48;]]>
</Line>
<Line Number="71">
<![CDATA[			CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="72">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_Space, Wrk_DateString);]]>
</Line>
<Line Number="73">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_MonthNames[Ref_DT.Mo-1], Wrk_DateString);]]>
</Line>
<Line Number="74">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_Space, Wrk_DateString);]]>
</Line>
<Line Number="75">
<![CDATA[		Else]]>
</Line>
<Line Number="76">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_MonthNames[Ref_DT.Mo-1], Wrk_DateString);]]>
</Line>
<Line Number="77">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_Space, Wrk_DateString);]]>
</Line>
<Line Number="78">
<![CDATA[			If (Ref_DT.Da > 9) Then]]>
</Line>
<Line Number="79">
<![CDATA[				Wrk_Digit.DATA[0] := (Ref_DT.Da / 10)+48;]]>
</Line>
<Line Number="80">
<![CDATA[				CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="81">
<![CDATA[			End_If;]]>
</Line>
<Line Number="82">
<![CDATA[			Wrk_Digit.DATA[0] := (Ref_DT.Da MOD 10)+48;]]>
</Line>
<Line Number="83">
<![CDATA[			CONCAT (Wrk_DateString, Wrk_Digit, Wrk_DateString);]]>
</Line>
<Line Number="84">
<![CDATA[			CONCAT (Wrk_DateString, Cfg_CommaSpace, Wrk_DateString);]]>
</Line>
<Line Number="85">
<![CDATA[		End_If;]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[// Final part of the pretty date is the year, in whatever number of digits it needs]]>
</Line>
<Line Number="88">
<![CDATA[		DTOS (Ref_DT.Yr, Wrk_YearString);]]>
</Line>
<Line Number="89">
<![CDATA[		CONCAT (Wrk_DateString, Wrk_YearString, Wrk_DateString);]]>
</Line>
<Line Number="90">
<![CDATA[	End_If;]]>
</Line>
<Line Number="91">
<![CDATA[End_If;]]>
</Line>
<Line Number="92">
<![CDATA[]]>
</Line>
<Line Number="93">
<![CDATA[// Check if the time is invalid.  If so, copy the bad time string and flag it]]>
</Line>
<Line Number="94">
<![CDATA[If (((Ref_DT.Hr<0) OR (Ref_DT.Hr>23) OR (Ref_DT.Min<0) OR (Ref_DT.Min>59)) OR ((Ref_DT.Sec<0) OR (Ref_DT.Sec>59) OR (Ref_DT.uSec<0)) OR (Ref_DT.uSec>999999)) Then]]>
</Line>
<Line Number="95">
<![CDATA[	CONCAT (Wrk_TimeString, Cfg_BadTimeString, Wrk_TimeString);]]>
</Line>
<Line Number="96">
<![CDATA[	Sts_InvTime := 1;]]>
</Line>
<Line Number="97">
<![CDATA[Else]]>
</Line>
<Line Number="98">
<![CDATA[]]>
</Line>
<Line Number="99">
<![CDATA[// Time is valid, so generate the time string.  Do we want 12-hour time with no leading zero or 24-hour time with leading zero?]]>
</Line>
<Line Number="100">
<![CDATA[	Sts_InvTime := 0;]]>
</Line>
<Line Number="101">
<![CDATA[	If (Cfg_12Hr AND (NOT Cfg_ISODate)) Then]]>
</Line>
<Line Number="102">
<![CDATA[		Wrk_Hour := ((Ref_DT.Hr+11) MOD 12) +1;]]>
</Line>
<Line Number="103">
<![CDATA[		If (Wrk_Hour > 9) Then]]>
</Line>
<Line Number="104">
<![CDATA[			Wrk_Digit.DATA[0] := (Wrk_Hour / 10)+48;]]>
</Line>
<Line Number="105">
<![CDATA[			CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="106">
<![CDATA[		End_If;]]>
</Line>
<Line Number="107">
<![CDATA[		Wrk_Digit.DATA[0] := (Wrk_Hour MOD 10)+48;]]>
</Line>
<Line Number="108">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="109">
<![CDATA[	Else]]>
</Line>
<Line Number="110">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Hr / 10)+48;]]>
</Line>
<Line Number="111">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="112">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Hr MOD 10)+48;]]>
</Line>
<Line Number="113">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="114">
<![CDATA[	End_If;]]>
</Line>
<Line Number="115">
<![CDATA[	CONCAT (Wrk_TimeString, Cfg_Colon, Wrk_TimeString);]]>
</Line>
<Line Number="116">
<![CDATA[]]>
</Line>
<Line Number="117">
<![CDATA[// Minutes: always two digits]]>
</Line>
<Line Number="118">
<![CDATA[	Wrk_Digit.DATA[0] := (Ref_DT.Min / 10)+48;]]>
</Line>
<Line Number="119">
<![CDATA[	CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="120">
<![CDATA[	Wrk_Digit.DATA[0] := (Ref_DT.Min MOD 10)+48;]]>
</Line>
<Line Number="121">
<![CDATA[	CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="122">
<![CDATA[]]>
</Line>
<Line Number="123">
<![CDATA[// Seconds, if selected]]>
</Line>
<Line Number="124">
<![CDATA[	If (Cfg_InclSec) Then]]>
</Line>
<Line Number="125">
<![CDATA[		CONCAT (Wrk_TimeString, Cfg_Colon, Wrk_TimeString);]]>
</Line>
<Line Number="126">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Sec / 10)+48;]]>
</Line>
<Line Number="127">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="128">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.Sec MOD 10)+48;]]>
</Line>
<Line Number="129">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="130">
<![CDATA[	End_If;]]>
</Line>
<Line Number="131">
<![CDATA[]]>
</Line>
<Line Number="132">
<![CDATA[// Microseconds, if seconds and microseconds selected]]>
</Line>
<Line Number="133">
<![CDATA[	If (Cfg_InclSec AND Cfg_InclMicrosec) Then]]>
</Line>
<Line Number="134">
<![CDATA[		CONCAT (Wrk_TimeString, Cfg_Period, Wrk_TimeString);]]>
</Line>
<Line Number="135">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.uSec / 100000)+48;]]>
</Line>
<Line Number="136">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="137">
<![CDATA[		Wrk_Digit.DATA[0] := ((Ref_DT.uSec / 10000) MOD 10)+48;]]>
</Line>
<Line Number="138">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="139">
<![CDATA[		Wrk_Digit.DATA[0] := ((Ref_DT.uSec / 1000) MOD 10)+48;]]>
</Line>
<Line Number="140">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="141">
<![CDATA[		Wrk_Digit.DATA[0] := ((Ref_DT.uSec / 100) MOD 10)+48;]]>
</Line>
<Line Number="142">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="143">
<![CDATA[		Wrk_Digit.DATA[0] := ((Ref_DT.uSec / 10) MOD 10)+48;]]>
</Line>
<Line Number="144">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="145">
<![CDATA[		Wrk_Digit.DATA[0] := (Ref_DT.uSec MOD 10)+48;]]>
</Line>
<Line Number="146">
<![CDATA[		CONCAT (Wrk_TimeString, Wrk_Digit, Wrk_TimeString);]]>
</Line>
<Line Number="147">
<![CDATA[	End_If;]]>
</Line>
<Line Number="148">
<![CDATA[]]>
</Line>
<Line Number="149">
<![CDATA[// Finally, if 12-hour and not ISO, add AM/PM indicator]]>
</Line>
<Line Number="150">
<![CDATA[	If (Cfg_12Hr AND (NOT Cfg_ISODate)) Then]]>
</Line>
<Line Number="151">
<![CDATA[		CONCAT (Wrk_TimeString, Cfg_Space, Wrk_TimeString);]]>
</Line>
<Line Number="152">
<![CDATA[		If (Ref_DT.Hr >= 12) Then]]>
</Line>
<Line Number="153">
<![CDATA[			CONCAT (Wrk_TimeString, Cfg_PMString, Wrk_TimeString);]]>
</Line>
<Line Number="154">
<![CDATA[		Else]]>
</Line>
<Line Number="155">
<![CDATA[			CONCAT (Wrk_TimeString, Cfg_AMString, Wrk_TimeString);]]>
</Line>
<Line Number="156">
<![CDATA[		End_If;]]>
</Line>
<Line Number="157">
<![CDATA[	End_If;]]>
</Line>
<Line Number="158">
<![CDATA[End_If;]]>
</Line>
<Line Number="159">
<![CDATA[]]>
</Line>
<Line Number="160">
<![CDATA[// Last, Output = date <space> time]]>
</Line>
<Line Number="161">
<![CDATA[CONCAT (Wrk_DateString,Cfg_Space,Wrk_DateString);]]>
</Line>
<Line Number="162">
<![CDATA[CONCAT (Wrk_DateString,Wrk_TimeString,Ref_Out);]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="T_Now" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-04-04T14:39:38.945Z" CreatedBy="NA\dereed" EditedDate="2008-07-02T16:36:29.989Z" EditedBy="NA\dereed"
 SoftwareRevision="v16.03">
<Description>
<![CDATA[Current DateTime]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[Returns the current local Date and Time from the controller clock as a DateTime In/Out Parameter

This instuction depends on the (external) DateTime data type:
   Yr : DINT    year
   Mo : DINT    month
   Da : DINT    day
   Hr : DINT    hour
   Min : DINT    minute
   Sec : DINT    second
   uSec : DINT    microsecond]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Ref_Out" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Returned current date/time from controller clock]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_DT" DataType="DINT" Dimensions="7" Radix="Decimal">
<Description>
<![CDATA[Date / Time from GSV instruction (requires array)]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><Array DataType="DINT" Dimensions="7" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
<Element Index="[2]" Value="0"/>
<Element Index="[3]" Value="0"/>
<Element Index="[4]" Value="0"/>
<Element Index="[5]" Value="0"/>
<Element Index="[6]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Returns current Local Date and Time to a Date/Time in/out parameter]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
T_Now:  TIME -- RETURN CURRENT DATE / TIME
============================================================
Revision 1.0-Example:  2008-Jul-02, DER
Release for V17 CD as Date/Time Examples
============================================================
Returns the current local Date and Time from the controller clock as a DateTime
(Yr : DINT, 
Mo : DINT,
Da : DINT,
Hr : DINT,
Min : DINT,
Sec : DINT,
uSec : DINT)
============================================================
POWERUP / INVALID STATE HANDLING
============================================================
This object returns the date and time every scan when enabled.
No powerup or invalid state handling is necessary.
============================================================
GET CURRENT LOCAL TIME
============================================================
Use a GSV (Get System Value) to get the current local clock time.]]>
</Comment>
<Text>
<![CDATA[GSV(WallClockTime,,LocalDateTime,Wrk_DT[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Return the date and time values in the In/Out (reference) DateTime Tag.

(NOTE: You can type <ALT>- 0 (zero) or click the  icon on the toolbar
to close the Controller Organizer tree if you would like a wider view of this rung.)]]>
</Comment>
<Text>
<![CDATA[MOV(Wrk_DT[0],Ref_Out.Yr)MOV(Wrk_DT[1],Ref_Out.Mo)MOV(Wrk_DT[2],Ref_Out.Da)MOV(Wrk_DT[3],Ref_Out.Hr)MOV(Wrk_DT[4],Ref_Out.Min)MOV(Wrk_DT[5],Ref_Out.Sec)MOV(Wrk_DT[6],Ref_Out.uSec);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="T_Scan" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-04-22T17:53:23.109Z" CreatedBy="NA\dereed" EditedDate="2008-07-02T16:31:36.637Z" EditedBy="NA\dereed"
 SoftwareRevision="v16.03">
<Description>
<![CDATA[Time Since Previous Scan]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Out" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true">
<Description>
<![CDATA[Time Since Previous Scan, in Seconds]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_PrevCSTValue" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Value of CST last scan (2 DINTs in uSec)]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><Array DataType="DINT" Dimensions="2" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_CSTValue" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Place to store current value from controller clock (2 DINTs in uSec)]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><Array DataType="DINT" Dimensions="2" Radix="Decimal">
<Element Index="[0]" Value="0"/>
<Element Index="[1]" Value="0"/>
</Array>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_ScanTime" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Intermediate Result: computed scan time]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Return time since previous scan]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
T_Scan:  TIME -- RETURN SCAN TIME
============================================================
Revision 1.0-Example:  2008-Jul-02, DER
Release for V17 CD as Date/Time Examples
============================================================
Returns the time between the previous scan of the instance and the
current scan of the same instance as a REAL number of Seconds.

============================================================
POWERUP / INVALID STATE HANDLING
============================================================
On powerup or program-to-run transition, the time since previous scan
is probably meaningless and/or may overflow the instruction,
so the current time stamp is grabbed and a scan time of ZERO
is returned.  Any object using the computed scan time must handle the
first-scan report of  0.0  in an appropriate manner (such as not dividing by zero).
============================================================
GET CURRENT COORDINATED SYSTEM TIME (CST) VALUE
============================================================
Use a GSV (Get System Value) to get the current controllerCST timestamp.]]>
</Comment>
<Text>
<![CDATA[GSV(CST,,CurrentValue,Wrk_CSTValue[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[On first scan, return a zero scan time.  If we were to compute a scan
time, we'd likely overflow and create a minor fault.]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)CLR(Wrk_ScanTime);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[This rungs does  of some  to compute the number of
microseconds since the previous scan.  If the lower 32-bits of the CST value wrapped
from positive to negative, we need to add 2**32 microseconds to the computed difference.
But we can't add that all at once, because you can't put 2**32 into a DINT.  The biggest
DINT is 2**31 - 1, so we add that twice (= 2**32 -2) and then add 2 to complete the
wraparound.

If the CST didn't wrap from positive to negative, the simple differece between last
scan and this scan will give us the number of microseconds we want.

In either case, divide by a million (REAL) to get to REAL seconds.]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)[LES(Wrk_CSTValue[0],Wrk_PrevCSTValue[0]) CPT(Wrk_ScanTime,(2+Wrk_CSTValue[0]+2147483647-Wrk_PrevCSTValue[0]+2147483647)/1000000.0) ,GEQ(Wrk_CSTValue[0],Wrk_PrevCSTValue[0]) CPT(Wrk_ScanTime,(Wrk_CSTValue[0]-Wrk_PrevCSTValue[0])/1000000.0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[This rung does the same thing as the previous rung, but for the 
of the 64-bit CST value.  The result is ADDED to the result from the rung above
to get the total scan time in seconds since this instruction was last executed.]]>
</Comment>
<Text>
<![CDATA[XIO(S:FS)[LES(Wrk_CSTValue[1],Wrk_PrevCSTValue[1]) CPT(Wrk_ScanTime,Wrk_ScanTime + ((2+Wrk_CSTValue[1]+2147483647-Wrk_PrevCSTValue[1]+2147483647)*2147.483648)) ,GEQ(Wrk_CSTValue[1],Wrk_PrevCSTValue[1]) CPT(Wrk_ScanTime,Wrk_ScanTime + ((Wrk_CSTValue[1]-Wrk_PrevCSTValue[1])/2147.483648)) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Now stash the current CST value (two 32-bit DINTs for the 64-bit CST value)
for use as the previous-scan value next time around.]]>
</Comment>
<Text>
<![CDATA[MOV(Wrk_CSTValue[0],Wrk_PrevCSTValue[0])MOV(Wrk_CSTValue[1],Wrk_PrevCSTValue[1]);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[And copy our working total (which changes during the scan, and so is hidden) to our (public) output.]]>
</Comment>
<Text>
<![CDATA[MOV(Wrk_ScanTime,Out);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="T_SEL" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2008-04-22T17:21:16.578Z" CreatedBy="NA\dereed" EditedDate="2008-07-02T16:36:54.865Z" EditedBy="NA\dereed"
 SoftwareRevision="v16.03">
<Description>
<![CDATA[DateTime Select]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction uses an Input bit signal to select one of two Date/Time values.

NOTE  The selected Date/Time is only  as-is;
it is NOT  to a valid Gregorian Date and Time:

NOTE:  Inp_Sel is defaulted to 1 so this instruction may be used on a Ladder
Diagram routine rung with the rung condition as the selector: Rung True 
selects DT1, Rung False selects DT0.  The Inp_Sel is INVERTED when
EnableIn is False (False Rung).  This inversion may be useful beyond this
Ladder Diagram function.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT0" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[DateTime Selected when Inp_Sel = 0]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT1" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[DateTime Selected when Inp_Sel = 1]]>
</Description>
</Parameter>
<Parameter Name="Inp_Sel" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Selector: 1=Select Ref_DT1, 0=Select Ref_DT0]]>
</Description>
<DefaultData>01</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="Ref_Out" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Selected DateTime]]>
</Description>
</Parameter>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Invert the Inp_Sel selection: False = DT1, True = DT0]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
T_SEL:  TIME -- SELECT :  EnableIn False Handling
============================================================
Act as if the Inp_Sel selector bit is inverted.

NOTE: Inp_Sel defaults to 1 so this instruction can be used on a Ladder rung
with the rung True state selecting DT1 and the rung False state selecting DT0.

If the selector bit is TRUE, move the data elements from DT0 to the output.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_Sel)[MOV(Ref_DT0.Yr,Ref_Out.Yr) MOV(Ref_DT0.Mo,Ref_Out.Mo) MOV(Ref_DT0.Da,Ref_Out.Da) ,MOV(Ref_DT0.Hr,Ref_Out.Hr) MOV(Ref_DT0.Min,Ref_Out.Min) MOV(Ref_DT0.Sec,Ref_Out.Sec) ,MOV(Ref_DT0.uSec,Ref_Out.uSec) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[If the selector bit is FALSE, move the data elements from DT1 to the output.]]>
</Comment>
<Text>
<![CDATA[XIO(Inp_Sel)[MOV(Ref_DT1.Yr,Ref_Out.Yr) MOV(Ref_DT1.Mo,Ref_Out.Mo) MOV(Ref_DT1.Da,Ref_Out.Da) ,MOV(Ref_DT1.Hr,Ref_Out.Hr) MOV(Ref_DT1.Min,Ref_Out.Min) MOV(Ref_DT1.Sec,Ref_Out.Sec) ,MOV(Ref_DT1.uSec,Ref_Out.uSec) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Select DT based on input bit state]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
T_SEL:  TIME -- SELECT
============================================================
Revision 0.4-Draft:  2008-07-01, DER
Added EnableInFalse Routine to allow use on a Ladder Rung with XIC/XIO.
Default Inp_Sel = 1 and treat it as INVERTED on a false rung to do this.
============================================================
This instruction uses an Input bit signal to select one of two Date/Time values.
NOTE  The selected Date/Time is only  as-is;
it is NOT , that is, given as a valid (if possible)
Gregorian Date and Time:

*  0 <= Microseconds < 1,000,000
*  0 <= Seconds < 60    (NOTE: this instruction cannot add leap seconds;  sorry!
*  0 <= Minutes < 60
*  0 <= Hours < 24
*  1 <= Day <= 31 AND Date is a Valid Gregorian Date (see below)
*  1 <= Month <= 12
============================================================
POWERUP / INVALID STATE HANDLING
============================================================
This logic determines a selectioin result every scan when enabled
No powerup or invalid state handling is necessary.
============================================================
IF THE INPUT BIT IS TRUE, SELECT INPUT DT1
============================================================
Just examine the selector bit; if it is TRUE, move the data elements from DT1 to the output.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_Sel)[MOV(Ref_DT1.Yr,Ref_Out.Yr) MOV(Ref_DT1.Mo,Ref_Out.Mo) MOV(Ref_DT1.Da,Ref_Out.Da) ,MOV(Ref_DT1.Hr,Ref_Out.Hr) MOV(Ref_DT1.Min,Ref_Out.Min) MOV(Ref_DT1.Sec,Ref_Out.Sec) ,MOV(Ref_DT1.uSec,Ref_Out.uSec) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[If the selector bit is FALSE, move the data elements from DT0 to the output.]]>
</Comment>
<Text>
<![CDATA[XIO(Inp_Sel)[MOV(Ref_DT0.Yr,Ref_Out.Yr) MOV(Ref_DT0.Mo,Ref_Out.Mo) MOV(Ref_DT0.Da,Ref_Out.Da) ,MOV(Ref_DT0.Hr,Ref_Out.Hr) MOV(Ref_DT0.Min,Ref_Out.Min) MOV(Ref_DT0.Sec,Ref_Out.Sec) ,MOV(Ref_DT0.uSec,Ref_Out.uSec) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="T_Sun" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-05-02T21:03:59.506Z" CreatedBy="NA\dereed" EditedDate="2008-07-02T16:41:51.733Z" EditedBy="NA\dereed"
 SoftwareRevision="v16.03">
<Description>
<![CDATA[Sun Rise / Set / Az/El]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction takes a given Date/Time, and for the Date part, plus the configured latitude, longitude and UTC offset, returns the Date/Time of local sunrise and local sunset (to the nearest minute, to an accuracy of within about two minutes....).

Solar Azimuth (heading, clockwise in degrees from true north) and Elevation (degrees above horizon) are calculated and accurate to within about half a degree when the sun is above the horizon.  Azimuth bearing is not necessarily accurate when Elevation is more than a degree or two negative!

The given Date is assumed VALID. If necessary, check using T_Valid first!

NOTE:  This instruction only uses the month and day to estimate the sunrise and sunset times to within a couple minutes.  It does NOT deal with detailed astronomical calculations based on planetary models!!!  It is based on the current Gregorian calendar and does NOT deal with Julian dates for dates before 1582 (or 1753 or whenever your place of interest switched to the Gregorian Calendar (see Wikipedia on Gregorian Calendar for details)!

NOTE:  For algorithms, see http://www.srrb.noaa.gov/highlights/sunrise/solareqns.PDF

NOTE:  To get your Latitude and Longitude, try http://www.batchgeocode.com/lookup/]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Date/Time for which to calculate Rise, Set, Az/El Position]]>
</Description>
</Parameter>
<Parameter Name="Ref_Out_Rise" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Input Date plus Calculated Time of Local Sunrise]]>
</Description>
</Parameter>
<Parameter Name="Ref_Out_Set" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Input Date plus Calculated Time of Local Sunset]]>
</Description>
</Parameter>
<Parameter Name="Cfg_Lat" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Latitude of location in decimal degrees (+ = East, - = West)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_Long" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Longitude of location in decimal degrees (+ = North, - = South)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_UTCOffset" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Offset from UTC in Hours (+ = East, - = West)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_Azimuth" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Solar Azimuth angle (deg) 0 to 359.xxx,
0 = true north]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_Elevation" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Solar Elevation (deg), 0 = horizon, 90 = overhead]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_MidnightSun" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=24-hour daylight, no sunset this date]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_NoonNight" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=24-hour night, no sunrise this date]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_InvalidCfg" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=Bad Lat/Long
or UTC Offset configuration]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_Sunset" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Sunset local time in minutes after midnight]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Sunrise" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Sunrise local time in minutes after midnight]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_RHA" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Rise / Set Hour angle in radians]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Decl" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Solar declination angle in radians]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_EQTime" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Equatorial Time in minutes]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_FYr" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Fractional year in radians 1/1 = 0.0, 12/31 = 2*pi]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_DoY" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Day of the year, from 1 to 366]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Function of month for calculating day of year]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Lat" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Local latitude converted to radians]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_HrCos" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Hour Angle Cosine, -1 to 1 for rise and set]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Elevation" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Elevation angle cosine in radians]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Azimuth" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Azimuth angle cosine in radians]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SHA" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Actual solar hour angle for Az/El calcs]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Long" DataType="REAL" Radix="Float">
<Description>
<![CDATA[Longitude in Radians WEST of UTC]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Calculate local sunrise and sunset Date/Time outputs]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// T_Sun : Sunrise / Sunset]]>
</Line>
<Line Number="1">
<![CDATA[// ]]>
</Line>
<Line Number="2">
<![CDATA[//  This instruction takes a given Date/Time, and for the Date part, plus the configured]]>
</Line>
<Line Number="3">
<![CDATA[//  latitude, longitude and UTC offset, returns the Date/Time of local sunrise and local sunset]]>
</Line>
<Line Number="4">
<![CDATA[//  (to the nearest minute, to an accuracy of within about two minutes....).]]>
</Line>
<Line Number="5">
<![CDATA[// ]]>
</Line>
<Line Number="6">
<![CDATA[//  The given Date is assumed VALID. If necessary, check using T_Valid first!]]>
</Line>
<Line Number="7">
<![CDATA[//]]>
</Line>
<Line Number="8">
<![CDATA[//  NOTE:  The Time part of Input Parameter DT (hours, minutes, seconds, microseconds) is ignored.]]>
</Line>
<Line Number="9">
<![CDATA[//]]>
</Line>
<Line Number="10">
<![CDATA[//  NOTE:  This instruction only uses the month and day to estimate the sunrise and sunset times to within a couple]]>
</Line>
<Line Number="11">
<![CDATA[//  minutes.  It does NOT deal with detailed astronomical calculations based on planetary models!!!  It is based on the]]>
</Line>
<Line Number="12">
<![CDATA[//  current Gregorian calendar and does NOT deal with Julian dates for dates before 1582 (or 1753 or whenever your place]]>
</Line>
<Line Number="13">
<![CDATA[//  of interest switched to the Gregorian Calendar (see Wikipedia on Gregorian Calendar for details)!]]>
</Line>
<Line Number="14">
<![CDATA[//]]>
</Line>
<Line Number="15">
<![CDATA[//  NOTE:  For algorithms, see http://www.srrb.noaa.gov/highlights/sunrise/solareqns.PDF]]>
</Line>
<Line Number="16">
<![CDATA[//  NOTE:  To get your Latitude and Longitude, try http://www.batchgeocode.com/lookup/]]>
</Line>
<Line Number="17">
<![CDATA[//]]>
</Line>
<Line Number="18">
<![CDATA[//  Revision 1.0-Example:  2008-Jul-02, DER]]>
</Line>
<Line Number="19">
<![CDATA[//	Release for V17 CD as Date/Time Examples]]>
</Line>
<Line Number="20">
<![CDATA[//]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[// Flag bad Position or UTC Offset data and exit  (allow for +/- 13-hour offsets plus DST)]]>
</Line>
<Line Number="23">
<![CDATA[IF ((Cfg_Lat > 90.0) OR (Cfg_Lat < -90.0) OR (Cfg_Long > 180.0) OR (Cfg_Long < -180.0) OR (Cfg_UTCOffset > 14.0) OR (Cfg_UTCOffset < -14.0)) THEN]]>
</Line>
<Line Number="24">
<![CDATA[	Sts_InvalidCfg := 1;]]>
</Line>
<Line Number="25">
<![CDATA[	Ref_Out_Rise.Hr := 0;]]>
</Line>
<Line Number="26">
<![CDATA[	Ref_Out_Rise.Min := 0;]]>
</Line>
<Line Number="27">
<![CDATA[	Ref_Out_Set.Hr := 0;]]>
</Line>
<Line Number="28">
<![CDATA[	Ref_Out_Set.Min := 0;]]>
</Line>
<Line Number="29">
<![CDATA[	Sts_NoonNight := 0;]]>
</Line>
<Line Number="30">
<![CDATA[	Sts_MidnightSun := 0;]]>
</Line>
<Line Number="31">
<![CDATA[	Val_Azimuth := 0.0;]]>
</Line>
<Line Number="32">
<![CDATA[	Val_Elevation := 0.0;]]>
</Line>
<Line Number="33">
<![CDATA[ELSE]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[// Configs are valid - clear the invalid flag and do the calculations ]]>
</Line>
<Line Number="36">
<![CDATA[	Sts_InvalidCfg := 0;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[// First, convert entered Latitude in degrees to radians]]>
</Line>
<Line Number="39">
<![CDATA[	Wrk_Lat := Cfg_Lat * 0.017453293;]]>
</Line>
<Line Number="40">
<![CDATA[// Entered Long is EAST, calculations want it WEST... and in Degrees]]>
</Line>
<Line Number="41">
<![CDATA[	Wrk_Long := -Cfg_Long;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[// Calculate the Day of the Year]]>
</Line>
<Line Number="44">
<![CDATA[	Wrk_F := (Ref_DT.Mo + 9) MOD 12;]]>
</Line>
<Line Number="45">
<![CDATA[	Wrk_DoY := ((Wrk_F*306+5)/10+Ref_DT.Da+60) MOD 366;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[// Calculate the Fractional Year in RADIANS (Jan 1 = 0.0, Dec. 31 = about 2 pi)]]>
</Line>
<Line Number="48">
<![CDATA[	Wrk_FYr := 0.017214206 * (Wrk_DoY - 1 + (Ref_DT.Hr-12.0)/24.0);]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[// Now calculate the solar time on the equator at 0 Longitude (in minutes)]]>
</Line>
<Line Number="51">
<![CDATA[	Wrk_EQTime := 229.18 *(0.000075 + 0.001868*cos(Wrk_FYr) - 0.032077*sin(Wrk_FYr) - 0.014615*cos(2.0*Wrk_FYr) - 0.040849*sin(2.0*Wrk_FYr));]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[// And calculate the solar declination angle in radians]]>
</Line>
<Line Number="54">
<![CDATA[	Wrk_Decl := 0.006918 - 0.399912*cos(Wrk_FYr) + 0.070257*sin(Wrk_FYr) - 0.006758*cos(2.0*Wrk_FYr) + 0.000907*sin(2.0*Wrk_FYr) - 0.002697*cos(3.0*Wrk_FYr) + 0.00148*sin(3.0*Wrk_FYr);]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[// Now calculate the Hour Angle cosine, corresponding to the angle (time) from solar noon to sunrise (-) and sunset (+)]]>
</Line>
<Line Number="57">
<![CDATA[	Wrk_HrCos := (-0.014538081/cos(Wrk_Lat)/cos(Wrk_Decl))- tan(Wrk_Lat)*tan(Wrk_Decl);]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[// If the Hour Angle cosine is less than -1, then we're in a polar location with midnight sun...]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[	IF (Wrk_HrCos < -1.0) THEN]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[		Ref_Out_Rise.Hr := 0;]]>
</Line>
<Line Number="64">
<![CDATA[		Ref_Out_Rise.Min := 0;]]>
</Line>
<Line Number="65">
<![CDATA[	]]>
</Line>
<Line Number="66">
<![CDATA[		Ref_Out_Set.Hr := 0;]]>
</Line>
<Line Number="67">
<![CDATA[		Ref_Out_Set.Min := 0;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[		Sts_NoonNight := 0;]]>
</Line>
<Line Number="70">
<![CDATA[		Sts_MidnightSun := 1;]]>
</Line>
<Line Number="71">
<![CDATA[]]>
</Line>
<Line Number="72">
<![CDATA[// And if the Hour Anlge cosine is greater than 1, then we're in a polar location with noon darkness...]]>
</Line>
<Line Number="73">
<![CDATA[]]>
</Line>
<Line Number="74">
<![CDATA[	ELSIF (Wrk_HrCos > 1.0) THEN]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[		Ref_Out_Rise.Hr := 0;]]>
</Line>
<Line Number="77">
<![CDATA[		Ref_Out_Rise.Min := 0;]]>
</Line>
<Line Number="78">
<![CDATA[	]]>
</Line>
<Line Number="79">
<![CDATA[		Ref_Out_Set.Hr := 0;]]>
</Line>
<Line Number="80">
<![CDATA[		Ref_Out_Set.Min := 0;]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
<Line Number="82">
<![CDATA[		Sts_NoonNight := 1;]]>
</Line>
<Line Number="83">
<![CDATA[		Sts_MidnightSun := 0;]]>
</Line>
<Line Number="84">
<![CDATA[ ]]>
</Line>
<Line Number="85">
<![CDATA[	ELSE]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[// Otherwise we have a day with a sunrise and sunset and we can calculate the times.]]>
</Line>
<Line Number="88">
<![CDATA[		Wrk_RHA := 57.29577951 * acos ( Wrk_HrCos );]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[// We have all we need to calculate when the sun rises and sets at our longitude, accounting for time zone]]>
</Line>
<Line Number="91">
<![CDATA[// (converted from hours to minutes) in minutes since local midnight. 720 minutes = noon with no EQTime correction]]>
</Line>
<Line Number="92">
<![CDATA[// Adding 1440 minutes more ensures the Modulo math works if sunrise is before 00:00 local...]]>
</Line>
<Line Number="93">
<![CDATA[		Wrk_Sunrise := 2160.0 + 4.0 * (Wrk_Long - Wrk_RHA ) - Wrk_EQTime + Cfg_UTCOffset * 60.0;]]>
</Line>
<Line Number="94">
<![CDATA[		Wrk_Sunset := 2160.0 + 4.0 * (Wrk_Long + Wrk_RHA ) - Wrk_EQTime + Cfg_UTCOffset * 60.0;]]>
</Line>
<Line Number="95">
<![CDATA[]]>
</Line>
<Line Number="96">
<![CDATA[// Now fill out the output parameters (in this case, InOut parameters, because they are structures....)]]>
</Line>
<Line Number="97">
<![CDATA[		Ref_Out_Rise.Hr := (Wrk_Sunrise / 60) MOD 24;]]>
</Line>
<Line Number="98">
<![CDATA[		Ref_Out_Rise.Min := Wrk_Sunrise MOD 60;]]>
</Line>
<Line Number="99">
<![CDATA[	]]>
</Line>
<Line Number="100">
<![CDATA[		Ref_Out_Set.Hr := (Wrk_Sunset / 60) MOD 24;]]>
</Line>
<Line Number="101">
<![CDATA[		Ref_Out_Set.Min := Wrk_Sunset MOD 60;]]>
</Line>
<Line Number="102">
<![CDATA[]]>
</Line>
<Line Number="103">
<![CDATA[// And clear the polar status bits...	]]>
</Line>
<Line Number="104">
<![CDATA[		Sts_NoonNight := 0;]]>
</Line>
<Line Number="105">
<![CDATA[		Sts_MidnightSun := 0;]]>
</Line>
<Line Number="106">
<![CDATA[	]]>
</Line>
<Line Number="107">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="108">
<![CDATA[]]>
</Line>
<Line Number="109">
<![CDATA[// Now for the solar eaimuth and elevation...]]>
</Line>
<Line Number="110">
<![CDATA[	Wrk_SHA := ( (Wrk_EQTime - (4.0 * Wrk_Long) - (60.0 * Cfg_UTCOffset) + (Ref_DT.Hr * 60.0) +  Ref_DT.Min + (Ref_DT.Sec / 60.0) )/ 4.0 - 180.0)/ 57.29577951;]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[	Wrk_Elevation := ( cos(Wrk_SHA) * cos(Wrk_Decl) * cos(Wrk_Lat) ) + ( sin(Wrk_Decl) * sin(Wrk_Lat) );]]>
</Line>
<Line Number="113">
<![CDATA[	IF ( Wrk_Elevation < -1.0 ) THEN]]>
</Line>
<Line Number="114">
<![CDATA[		Wrk_Elevation := -1.0;]]>
</Line>
<Line Number="115">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="116">
<![CDATA[	IF ( Wrk_Elevation > 1.0 ) THEN]]>
</Line>
<Line Number="117">
<![CDATA[		Wrk_Elevation := 1.0;]]>
</Line>
<Line Number="118">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="119">
<![CDATA[]]>
</Line>
<Line Number="120">
<![CDATA[	Val_Elevation := 57.29577951 * asin (Wrk_Elevation);]]>
</Line>
<Line Number="121">
<![CDATA[]]>
</Line>
<Line Number="122">
<![CDATA[	Wrk_Azimuth := ( ( cos(Wrk_SHA) * cos(Wrk_Decl) * sin(Wrk_Lat) ) - ( sin(Wrk_Decl) * cos(Wrk_Lat) ) ) / cos(Val_Elevation / 57.29577951);]]>
</Line>
<Line Number="123">
<![CDATA[	IF ( Wrk_Azimuth < -1.0 ) THEN]]>
</Line>
<Line Number="124">
<![CDATA[		Wrk_Azimuth := -1.0;]]>
</Line>
<Line Number="125">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="126">
<![CDATA[	IF ( Wrk_Azimuth > 1.0 ) THEN]]>
</Line>
<Line Number="127">
<![CDATA[		Wrk_Azimuth := 1.0;]]>
</Line>
<Line Number="128">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="129">
<![CDATA[]]>
</Line>
<Line Number="130">
<![CDATA[	IF ( Wrk_SHA < 0 ) then]]>
</Line>
<Line Number="131">
<![CDATA[		Val_Azimuth := 180.0 - ( 57.29577951 * acos(Wrk_Azimuth) );]]>
</Line>
<Line Number="132">
<![CDATA[	ELSE]]>
</Line>
<Line Number="133">
<![CDATA[		Val_Azimuth := 180.0 + ( 57.29577951 * acos(Wrk_Azimuth) );]]>
</Line>
<Line Number="134">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="135">
<![CDATA[]]>
</Line>
<Line Number="136">
<![CDATA[END_IF;]]>
</Line>
<Line Number="137">
<![CDATA[]]>
</Line>
<Line Number="138">
<![CDATA[// Now fill in the rest of the output parameters...]]>
</Line>
<Line Number="139">
<![CDATA[]]>
</Line>
<Line Number="140">
<![CDATA[Ref_Out_Rise.Yr := Ref_DT.Yr;]]>
</Line>
<Line Number="141">
<![CDATA[Ref_Out_Rise.Mo := Ref_DT.Mo;]]>
</Line>
<Line Number="142">
<![CDATA[Ref_Out_Rise.Da := Ref_DT.Da;]]>
</Line>
<Line Number="143">
<![CDATA[Ref_Out_Rise.Sec := 0;]]>
</Line>
<Line Number="144">
<![CDATA[Ref_Out_Rise.uSec := 0;]]>
</Line>
<Line Number="145">
<![CDATA[	]]>
</Line>
<Line Number="146">
<![CDATA[Ref_Out_Set.Yr := Ref_DT.Yr;]]>
</Line>
<Line Number="147">
<![CDATA[Ref_Out_Set.Mo := Ref_DT.Mo;]]>
</Line>
<Line Number="148">
<![CDATA[Ref_Out_Set.Da := Ref_DT.Da;]]>
</Line>
<Line Number="149">
<![CDATA[Ref_Out_Set.Sec := 0;]]>
</Line>
<Line Number="150">
<![CDATA[Ref_Out_Set.uSec := 0;]]>
</Line>
<Line Number="151">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
