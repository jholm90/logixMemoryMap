</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="temp" DataType="REAL" Radix="Float">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="j" DataType="DINT" Radix="Decimal">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="i" DataType="DINT" Radix="Decimal">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[FOR i := 1 TO HowMany - 1 DO]]>
</Line>
<Line Number="2">
<![CDATA[	temp := DataArray[i];]]>
</Line>
<Line Number="3">
<![CDATA[	FOR j := i TO 1 BY -1 DO]]>
</Line>
<Line Number="4">
<![CDATA[		IF (DataArray[j-1] > temp) THEN]]>
</Line>
<Line Number="5">
<![CDATA[			DataArray[j] := DataArray[j-1];]]>
</Line>
<Line Number="6">
<![CDATA[		ELSE]]>
</Line>
<Line Number="7">
<![CDATA[			Exit;]]>
</Line>
<Line Number="8">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="10">
<![CDATA[	DataArray[j] := temp;]]>
</Line>
<Line Number="11">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
