<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
This sample project provides Add-On Instruction examples performing the operation of the SLC-500 Scale With Parameters instruction (SCL).
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SCLP(SCLP_Tag,SCL_DINT_Input,50,100,SCL_DINT_Output)AFI()MOV(SCL_DINT_Input,SCL_DINT_Output);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[SCLP(SCLP_WREAL_Tag,SCL_REAL_Input,50,100,SCL_REAL_Output)AFI()MOV(SCL_REAL_Input,SCL_REAL_Output);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[SCP(SCP_Tag,SCP_DINT_Input,0,1024,0,100,SCP_DINT_Output)AFI()MOV(SCP_DINT_Input,SCP_DINT_Output);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[SCP(SCPwRealTag,SCP_REAL_Input,0,1024,0,100,SCP_REAL_Output)AFI()MOV(SCP_REAL_Input,SCP_REAL_Output);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
