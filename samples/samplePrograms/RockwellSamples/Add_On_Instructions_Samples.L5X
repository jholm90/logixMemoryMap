<AddOnInstructionDefinition Name="LoopSimulation" Revision="1.0" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-01-16T20:22:10.067Z" CreatedBy="NA\Rockwell" EditedDate="2007-01-17T19:10:18.613Z" EditedBy="NA\Rockwell" SoftwareRevision="v16.00"
>
<Description>
<![CDATA[Simulates a control loop using a deadtime plus first order lag process simulation.  Must run in a periodic task.]]>
</Description>
<AdditionalHelpText>
<![CDATA[This instruction must run in a periodic task.

The deadtime samples are stored internally in the instruction in a REAL array of 1000 elements.  Since up to 1000 samples can be used for deadtime storage, the Deadtime can have a maximum value of 1000*Periodic Task Rate in seconds.  For example, if executed in a 100 msec periodic task, Deadtime can be up to 1000*0.1 = 100 seconds.  If Deadtime exceeds this value, DeadtimeInv will be set, and the instruction will use a Deadtime of 0.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="LoopOutput" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true">
<Description>
<![CDATA[Connect the output from a PID or PIDE instruction to this input.]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Deadtime" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Enter Deadtime in seconds.  Deadtime cannot exceed 1000*Periodic Task Rate in seconds.]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="TimeConstant" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Enter first order lag time constant in seconds]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Gain" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Enter a simulated process gain.]]>
</Description>
<DefaultData>00 00 80 3F</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="1.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Bias" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
<Description>
<![CDATA[Enter a simulated process bias.  Can be used to model an ambient condition.  Added after the Gain multiplication.]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="SimulatedPV" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true">
<Description>
<![CDATA[The simulated process variable.  Connect this to the PV input of a PID or PIDE instruction.]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="DeadtimeInv" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Flag to indicate that Deadtime has exceeded 1000*Periodic Task Rate in seconds.]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
