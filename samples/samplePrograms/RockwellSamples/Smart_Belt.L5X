<Routines>
<Routine Name="Exit_Belt_Speed_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Start_System_DI0)XIC(Smart_Belt.Axis_MAG.IP)MAJ(Exit_Belt_Axis,Exit_Belt.Axis_MAJ,0,Exit_Belt_Speed,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100.0,100.0,% of Time,Disabled,Programmed,0,None);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Stop_System_DI1)MAS(Exit_Belt_Axis,Exit_Belt.Axis_MAS,Jog,Yes,100,% of Maximum,Yes,100.0,% of Time);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOV(Exit_Belt_Axis.ActualPosition,Exit_Belt_Position_Display)MOV(Smart_Belt_Axis.ActualPosition,Smart_Belt_Position_Display);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Gearing" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ENABLE GEARING
This rung gears the Smart Belt to the Exis Belt in a 1:1 ratio. The correction move calculated in the Smart_Belt Correction rourtine is used to assure a uniform product gap between packages. ]]>
</Comment>
<Text>
<![CDATA[XIC(Start_System_DI0)XIC(Exit_Belt_Axis.ServoActionStatus)MAG(Smart_Belt_Axis,Exit_Belt_Axis,Smart_Belt.Axis_MAG,0,Smart_Belt.Axis_GearRatio,1,1,Actual,Real,Disabled,100,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Establish_Zero_Reference)MAS(Smart_Belt_Axis,Smart_Belt.StopGearing,Gear,No,100,% of Maximum,Yes,100.0,% of Time);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Initialization_Routine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Exit_Belt_Axis.EnableInputStatus)XIC(Motion_Group.GroupSynced)XIC(EnableServo_DI12)MSO(Exit_Belt_Axis,Exit_Belt.Axis_MSO);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(EnableServo_DI12)MSF(Exit_Belt_Axis,Exit_Belt.Axis_MSF);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Smart_Belt_Axis.EnableInputStatus)XIC(Motion_Group.GroupSynced)XIC(EnableServo_DI12)MSO(Smart_Belt_Axis,Smart_Belt.Axis_MSO);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(EnableServo_DI12)MSF(Smart_Belt_Axis,Smart_Belt.Axis_MSF);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Establish_Zero_Reference)MRP(Exit_Belt_Axis,Exit_Belt.Axis_MRP,Absolute,Actual,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Establish_Zero_Reference)MRP(Smart_Belt_Axis,Smart_Belt.Axis_MRP,Absolute,Actual,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  -- No warranty or implied merchantability.
