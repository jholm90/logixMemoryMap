<![CDATA[EQU(Home_Ladder.Basic_Index.Index,50)XIO(Servo_Drive.ConfigUpdateInProcess)GSV(AXIS,Servo_Drive,HomePosition,Home_Ladder.Read_Back_Active_Home_Values.Position)EQU(Home_Ladder.Active_Home_Set.Position,Home_Ladder.Read_Back_Active_Home_Values.Position)MOV(60,Home_Ladder.Basic_Index.Index);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
