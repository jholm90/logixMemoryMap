<![CDATA[EQU(Home_Ladder.Basic_Index.Index,220)XIO(Servo_Drive.ConfigUpdateInProcess)GSV(AXIS,Servo_Drive,HomeMode,Home_Ladder.Read_Back_Absolute_Home_Values.Mode)EQU(Home_Ladder.Absolute_Home_Set.Mode,Home_Ladder.Read_Back_Absolute_Home_Values.Mode)MOV(230,Home_Ladder.Basic_Index.Index);]]>
