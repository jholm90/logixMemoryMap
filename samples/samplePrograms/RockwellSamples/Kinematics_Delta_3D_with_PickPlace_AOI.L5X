<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(PC)OTU(ER)OTL(EN)OTL(IP)OTU(ErrorFound);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(AccDec,AccDecDisplay);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(EN)XIC(IP)MOV(UpDistance,VerticalDist[2])CPT(DownDist[2],-DownDistance)MOV(HorizontalDistance,HorizonDist[0])CPT(AccDec,Speed**2/(0.5* ABS(HorizontalDistance)))MOV(2,PickTermType)MOV(1,TermTypeDown);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(LocalStep,-1)XIC(EN)XIC(IP)[MCLM(CoordinateSystem,Mclm1,1,VerticalDist[0],Speed,Units per sec,AccDec,Units per sec2,AccDec,Units per sec2,S-Curve,100.0,100.0,% of Time,PickTermType,disabled,Programmed,0,0,None,0,0) ,XIC(Mclm1.IP) XIO(CoordinateSystem.MovePendingQueueFullStatus) MOV(1,LocalStep) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(LocalStep,1)XIC(EN)XIC(IP)[MCLM(CoordinateSystem,Mclm2,1,HorizonDist[0],Speed,Units per sec,AccDec,Units per sec2,AccDec,Units per sec2,S-Curve,100.0,100.0,% of Time,PickTermType,disabled,Programmed,0,0,None,0,0) ,XIC(Mclm2.IP) XIO(CoordinateSystem.MovePendingQueueFullStatus) MOV(2,LocalStep) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(LocalStep,2)XIC(EN)XIC(IP)[MCLM(CoordinateSystem,Mclm3,1,DownDist[0],Speed,Units per sec,AccDec,Units per sec2,AccDec,Units per sec2,S-Curve,100.0,100.0,% of Time,TermTypeDown,disabled,Programmed,0,0,None,0,0) ,XIC(Mclm3.PC) [MOV(-1,LocalStep) ,OTL(PC) OTU(EN) OTU(IP) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Move Step]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(-1,LocalStep);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
