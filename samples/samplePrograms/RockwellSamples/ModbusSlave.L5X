<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(ReadCoils)COP(Mod_Data_Coils0[WordStartC],ShiftArray[0],DoubWordCount)SUB(BitStartC,1,ShiftbitC);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ReadInputs)COP(Mod_Data_Contacts1[WordStartC],ShiftArray[0],DoubWordCount)SUB(BitStartC,1,ShiftbitC);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOV(0,ShftIndex);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[FOR(ShiftbitRight,ShftIndex,0,ShiftbitC,1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[COP(ShiftArray[0],Trans_Buffer[3],ByteCount2);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(NonZeroBit)ADD(2,ByteCount2,TargetByte)AND(Trans_Buffer[TargetByte],BlankArray[Notzero2],Trans_Buffer[TargetByte]);]]>
</Text>
</Rung>
</RLLContent>
