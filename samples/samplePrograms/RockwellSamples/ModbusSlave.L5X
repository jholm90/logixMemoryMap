<Routine Name="SlaveRecMonitor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Clear1)ACL(0,Yes,Yes);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(Hold3,Hold4)MOV(CharC.POS,Hold3);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(CharC.EN)ACB(0,CharC,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GEQ(CharC.POS,3)LEQ(CharC.POS,Hold4)XIC(CharC.DN)OTE(Store1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GRT(CharC.POS,maxCount)MOV(CharC.POS,maxCount);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(CharC.EN)ACB(0,CharC,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Store1)MOV(CharC.POS,read_serial_port.LEN);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Store1)XIO(read_serial_port.EN)ARD(0,Receive_Buffer[0],read_serial_port,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(read_serial_port.DN)OSR(NodeFound2,DataRec);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(DataRec)MOV(read_serial_port.LEN,recdbytes);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(DataRec)SUB(recdbytes,2,check_bytes);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(DataRec)ACL(0,Yes,Yes)OTU(write_serial_port.EN)CTU(Counter6,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(Timer7.DN)TON(Timer7,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Timer7.DN)MOV(Counter6.ACC,MsgCountRec)MOV(0,Counter6.ACC);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(DataRec)EQU(Receive_Buffer[0],Mod_Node_Address)CTU(Counter7,?,?)JSR(NodeThere,0);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Timer7.DN)MOV(Counter7.ACC,MsgCountTrans)MOV(0,Counter7.ACC);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SlaveTransmit" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(0,uLoop)BTD(255,0,uchCRCLo,0,8)BTD(255,0,uchCRCHi,0,8);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SUB(Trans_bytes,1,ubytes)FOR(CRCLoopT,uLoop,0,ubytes,1)MOV(uchCRCHi,Trans_Buffer[Trans_bytes]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(Trans_bytes,1,Trans_bytes)MOV(uchCRCLo,Trans_Buffer[Trans_bytes]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ADD(Trans_bytes,1,Trans_allbytes)MOV(Trans_allbytes,write_serial_port.LEN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(write_serial_port.EN)AWT(0,Trans_Buffer[0],write_serial_port,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(write_serial_port.DN)ACL(0,Yes,Yes)OTU(write_serial_port.EN);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="WriteCoils" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[COP(Receive_Buffer[7],ShiftArray[0],DoubWordCount)SUB(BitStartC,1,ShiftbitC)MOV(0,ShftIndex);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GRT(ShiftbitC,0)FOR(ShiftbitLeft,ShftIndex,0,ShiftbitC,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[COP(ShiftArray[0],TestArray[0],WordCount2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[This rung does a read/modify/write of Coils0 to TestArray so that you can write to individual bits in the Coils0 file. Bit 15 is not done through the MVM because if using an MVM with an indirectly addressed Dest, if the Dest starts out positive and after the MVM is executed ends up negative an arithmetic overflow will occur and cause a minor fault.]]>
</Comment>
<Text>
<![CDATA[[MVM(Mod_Data_Coils0[WordStartC],WordMaskS[BitStartC],TestArray[0]) MVM(Mod_Data_Coils0[EndWord],WordMaskE[BitEndC],TestArray[WordQuant]) ,[XIC(Mod_Data_Coils0[EndWord].15) OTL(TestArray[WordQuant].15) ,XIO(Mod_Data_Coils0[EndWord].15) OTU(TestArray[WordQuant].15) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[COP(TestArray[0],Mod_Data_Coils0[WordStartC],WordCount2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="WriteWords" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[COP(Receive_Buffer[7],Swapbuffer[0],Quantity)MOV(0,LCounter1)MOV(0,LCounter2);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[LBL(SwapFill)GEQ(LCounter2,Quantity)RET();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(Addr,LCounter2,TableAddr)SWPB(Swapbuffer[LCounter1],REVERSE,Mod_Data_HoldReg4[TableAddr]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ADD(LCounter1,1,LCounter1)ADD(LCounter2,1,LCounter2)JMP(SwapFill);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
