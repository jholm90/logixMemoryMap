<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="ST_Gear_Change" Disabled="false">
<Tags/>
<Routines>
<Routine Name="LadderFile" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(timer.DN)TON(timer,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(timer.DN)OTE(output);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ST_Gear_Change" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(* All information provided "AS IS" - No Warranty or implied merchantability. ]]>
</Line>
<Line Number="2">
<![CDATA[Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes *)]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[	(*** This program demonstrates how ST Language programs work.]]>
</Line>
<Line Number="7">
<![CDATA[	]]>
</Line>
<Line Number="8">
<![CDATA[	Turning the servos on, monitoring Inputs 1 & 2and changing the gear ratio up or]]>
</Line>
<Line Number="9">
<![CDATA[	down based on the input status.  If input 0 is enabled the program jumps to a ]]>
</Line>
<Line Number="10">
<![CDATA[	subroutine waits 2 secs then restarts at ServosOn.***)]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[	(*** Note the use of the tag State.  This is necessary in ST Language to control the program]]>
</Line>
<Line Number="13">
<![CDATA[	execution sequence. In SFC language the program executes one step at a time and waits for the]]>
</Line>
<Line Number="14">
<![CDATA[	transition to be complete before moving on to the next step. St Language executes like ladder.]]>
</Line>
<Line Number="15">
<![CDATA[	The programmer must control the program execution. ***) ]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[If State = 0 then]]>
</Line>
<Line Number="18">
<![CDATA[	MSO (axis0, axis0_MSO);			(* Turn servos on and set tags to initial values *)]]>
</Line>
<Line Number="19">
<![CDATA[	MSO (axis1, axis1_MSO);]]>
</Line>
<Line Number="20">
<![CDATA[	gear_ratio [:=] 0;]]>
</Line>
<Line Number="21">
<![CDATA[	State [:=] 1;]]>
</Line>
<Line Number="22">
<![CDATA[end_if;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[If axis0.ServoActionStatus & axis1.ServoActionStatus & State = 1 then]]>
</Line>
<Line Number="25">
<![CDATA[	State := 2;]]>
</Line>
<Line Number="26">
<![CDATA[end_if;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[		If State = 2 & input_1 then				(*** This IF statement monitors inputs 1, 2 & 0]]>
</Line>
<Line Number="29">
<![CDATA[												Depending on which one is enabled the program will either]]>
</Line>
<Line Number="30">
<![CDATA[			gear_ratio := gear_ratio + .5;		increase or decrease the gear ratio. If input 0 is pressed the ]]>
</Line>
<Line Number="31">
<![CDATA[			State := 3;							program jumps to a subroutine called LadderFile. ***)]]>
</Line>
<Line Number="32">
<![CDATA[			elsif State = 2 & input_2 then]]>
</Line>
<Line Number="33">
<![CDATA[				gear_ratio := gear_ratio - .5;]]>
</Line>
<Line Number="34">
<![CDATA[				State := 3;]]>
</Line>
<Line Number="35">
<![CDATA[			elsif State = 2 & input_0 then]]>
</Line>
<Line Number="36">
<![CDATA[				State := 5;]]>
</Line>
<Line Number="37">
<![CDATA[		end_if;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[If State = 3  then]]>
</Line>
<Line Number="40">
<![CDATA[	MAG (axis0, axis1, axis0_axis1_MAG, 1, gear_ratio, 1, 1, Actual, Real, Disabled, 10, 1);]]>
</Line>
<Line Number="41">
<![CDATA[end_if;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[If State = 3 then]]>
</Line>
<Line Number="45">
<![CDATA[	maj(axis1, axis1_MAJ, 0, Move_Speed, Unitspersec, 50, %ofMaximum, 50, %ofMaximum, 1,100.0,100.0,%ofTime, 0, 0,0,None);]]>
</Line>
<Line Number="46">
<![CDATA[end_if;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[If State = 3 & Local:0:I.Data = 0 then]]>
</Line>
<Line Number="51">
<![CDATA[	State := 1;]]>
</Line>
<Line Number="52">
<![CDATA[end_if;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[If State = 5 & Local:0:I.Data = 0 then		(*** This action turns on the servos and jumps to the ]]>
</Line>
<Line Number="55">
<![CDATA[	MSF (axis0, axis0_MSF);					LadderFile subroutine ***)]]>
</Line>
<Line Number="56">
<![CDATA[	MSF (axis1, axis1_MSF);]]>
</Line>
<Line Number="57">
<![CDATA[	JSR(LadderFile, 0);]]>
</Line>
<Line Number="58">
<![CDATA[end_if;]]>
</Line>
<Line Number="59">
<![CDATA[]]>
</Line>
<Line Number="60">
<![CDATA[If State = 5 & timer.DN & Local:0:I.Data = 0 then	(*** Wait for the subroutine timer to be done then]]>
</Line>
<Line Number="61">
<![CDATA[	State := 0;										loop back to the beginning of the program ***)]]>
</Line>
<Line Number="62">
<![CDATA[end_if;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
