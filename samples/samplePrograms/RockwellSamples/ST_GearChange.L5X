</Data>
</Tag>
<Tag Name="timer" TagType="Base" DataType="TIMER">
<Data>E5 B3 0F A0 D0 07 00 00 6F 51 00 00</Data>
<Data Format="Decorated"><Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="2000"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="20847"/>
<DataValueMember Name="EN" DataType="BOOL" Value="1"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="1"/>
