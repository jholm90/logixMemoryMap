<Tag Name="input_1" TagType="Alias" Radix="Decimal" AliasFor="Local:0:I.Data.1"/>
<Tag Name="input_2" TagType="Alias" Radix="Decimal" AliasFor="Local:0:I.Data.2"/>
<Tag Name="Move_Speed" TagType="Base" DataType="DINT" Radix="Decimal">
