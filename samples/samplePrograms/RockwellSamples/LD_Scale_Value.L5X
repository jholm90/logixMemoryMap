<Text>
<![CDATA[JSR(SCP_DINT,5,SCP_DINT_Input,0,1024,0,100,SCP_DINT_Output)AFI()MOV(SCP_DINT_Input,SCP_DINT_Output);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
