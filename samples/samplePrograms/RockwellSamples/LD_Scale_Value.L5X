<Routines>
<Routine Name="SCL_CPT_Example" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  - No Warranty or implied merchantability. 
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes

Scaled value = (input value x rate) + offset
Rate = (scaled max. - scaled min.) / (input max. - input min.)
Offset = scaled minimum - (input minimum x rate)]]>
</Comment>
<Text>
<![CDATA[CPT(SCL_CPT_Output,(SCL_CPT_Input * SCL_CPT_Rate) + SCL_CPT_Offset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SCP_CPT_Example" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[All information provided  - No Warranty or implied merchantability. 
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes


Scaled value = (input value x rate) + offset
Rate = (scaled max. - scaled min.) / (input max. - input min.)
Offset = scaled minimum - (input minimum x rate)]]>
</Comment>
<Text>
<![CDATA[CPT(SCP_CPT_Output,(SCP_CPT_Input * ((SCP_CPT_SclMax-SCP_CPT_SclMin)/(SCP_CPT_InMax-SCP_CPT_InMin))) + (SCP_CPT_SclMin - ((SCP_CPT_SclMax-SCP_CPT_SclMin)/(SCP_CPT_InMax-SCP_CPT_InMin))));]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
