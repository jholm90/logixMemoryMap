<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
The Recipe_Sweet_Cream_Op routine is an SFC that commands Equipment Phases in a sequence.
It utilizes the PCMD instruction to command the Equipment Phases, and waits for them to complete by looking at the data in the PHASE tag for each one.

]]>
</Comment>
<Text>
<![CDATA[JSR(Recipe_Sweet_Cream_Op,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Recipe_Sweet_Cream_Op" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Portrait" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="480" Y="1000" Operand="Reset_All" HideDesc="false" DescX="520" DescY="980" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_000" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[JSR(ResetAll);]]>
</Line>
<Line Number="1">
<![CDATA[Start := 0;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="300" Y="540" Operand="Step_Add_Cream" HideDesc="false" DescX="340" DescY="520" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_005" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Add_Cream_M2, Start, Result[3]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="700" Y="280" Operand="Step_Add_Egg" HideDesc="false" DescX="740" DescY="260" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_002" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Add_Egg_M2, Start, Result[1]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="6" X="480" Y="780" Operand="Step_Add_Milk" HideDesc="false" DescX="520" DescY="760" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="7" Operand="Action_006" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Add_Milk_M2, Start, Result[5]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="8" X="300" Y="280" Operand="Step_Add_Sugar" HideDesc="false" DescX="340" DescY="260" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_001" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Add_Sugar_M2, Start, Result[0]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="10" X="1080" Y="560" Operand="Step_Agitate" HideDesc="false" DescX="1120" DescY="540" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="11" Operand="Action_003" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Agitate_M2, Start, Result[2]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="12" X="720" Y="540" Operand="Step_Heat" HideDesc="false" DescX="760" DescY="520" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="13" Operand="Action_004" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[PCMD(Heat_M2, Start, Result[4]);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="14" X="400" Y="60" Operand="Wait_For_Start" HideDesc="false" DescX="440" DescY="40" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="15" Operand="Action_007" Qualifier="PulseFallingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[LoopCount := LoopCount + 1;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="16" X="400" Y="160" Operand="Tran_000" HideDesc="false" DescX="480" DescY="140" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Start]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="17" X="480" Y="400" Operand="Tran_001" HideDesc="false" DescX="560" DescY="380" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Add_Sugar.Complete AND]]>
</Line>
<Line Number="1">
<![CDATA[Add_Egg.Complete]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="18" X="480" Y="680" Operand="Tran_002" HideDesc="false" DescX="560" DescY="660" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Add_Cream.Complete AND]]>
</Line>
<Line Number="1">
<![CDATA[Heat.Complete]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="19" X="480" Y="900" Operand="Tran_003" HideDesc="false" DescX="560" DescY="880" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Add_Milk.Complete AND]]>
</Line>
<Line Number="1">
<![CDATA[Agitate.Complete]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="20" X="480" Y="1120" Operand="Tran_004" HideDesc="false" DescX="560" DescY="1100" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[Add_Cream.Idle AND]]>
</Line>
<Line Number="1">
<![CDATA[Add_Egg.Idle AND]]>
</Line>
<Line Number="2">
<![CDATA[Add_Milk.Idle AND]]>
</Line>
<Line Number="3">
<![CDATA[Add_Sugar.Idle AND]]>
</Line>
<Line Number="4">
<![CDATA[Agitate.Idle AND]]>
</Line>
<Line Number="5">
<![CDATA[Heat.Idle]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
</STContent>
</Condition>
</Transition>
