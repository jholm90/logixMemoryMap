<Routines>
<Routine Name="LadderFile" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(timer.DN)TON(timer,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(timer.DN)OTE(output);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SimpleMotion" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="560" Y="900" Operand="Increment_ratio_dwn" HideDesc="true" DescX="614" DescY="885" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_006" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[gear_ratio :=]]>
</Line>
<Line Number="1">
<![CDATA[gear_ratio - .5;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="240" Y="900" Operand="Increment_ratio_up" HideDesc="true" DescX="294" DescY="885" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_003" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[gear_ratio :=]]>
</Line>
<Line Number="1">
<![CDATA[gear_ratio + .5;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="240" Y="360" Operand="ServosOn" HideDesc="false" DescX="298" DescY="345" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MSO(axis1, axis1_MSO);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="6" Operand="Action_008" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[mso (axis0, axis0_MSO);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="7" Operand="Action_009" Qualifier="Pulse" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[gear_ratio := 0;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="8" X="220" Y="1460" Operand="Shutdown" HideDesc="false" DescX="274" DescY="1445" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_010" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MSF (axis0, aixs0_MSF);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="10" Operand="Action_011" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MSF (axis1, axis1_MSF);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="11" Operand="Action_004" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[JSR(LadderFile,0);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="12" X="240" Y="620" Operand="Step_to_Next" HideDesc="true" DescX="294" DescY="605" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true"/>
<Step ID="13" X="180" Y="1080" Operand="Turn_on_gearing" HideDesc="true" DescX="234" DescY="1065" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="14" Operand="Action_007" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MAG (axis0, axis1, axis0_axis1_MAG, 1, gear_ratio, 1, 1, Actual, Real, Disabled, 10, 1);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="15" X="180" Y="1240" Operand="jog_axis" HideDesc="false" DescX="234" DescY="1225" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="16" Operand="Action_002" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[maj(axis1, axis1_MAJ, 0, Move_Speed, Unitspersec, 50, %ofMaximum, 50, %ofMaximum, 1,100.0,100.0,%ofTime, 0, 0,0,None);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="17" X="240" Y="480" Operand="Tran_000" HideDesc="false" DescX="275" DescY="465" DescWidth="0">
<Condition>
