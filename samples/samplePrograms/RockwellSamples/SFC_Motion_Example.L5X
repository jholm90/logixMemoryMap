<Routines>
<Routine Name="LadderFile" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(timer.DN)TON(timer,?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(timer.DN)OTE(output);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SimpleMotion" Type="SFC">
<SFCContent SheetSize="Letter - 8.5 x 11 in" SheetOrientation="Landscape" StepName="Step" TransitionName="Tran" ActionName="Action" StopName="Stop">
<Step ID="0" X="200" Y="340" Operand="Initialize" HideDesc="false" DescX="320" DescY="400" DescWidth="0" InitialStep="true" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="1" Operand="Action_010" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[counter := 0;]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="2" X="160" Y="1100" Operand="Move_axis1" HideDesc="false" DescX="214" DescY="1085" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="3" Operand="Action_002" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[mam(axis1, axis1_MAM, 1, Move_Distance, Move_Speed, Unitspersec, 50, %ofMaximum, 50, %ofMaximum, 1,100.0,100.0,%ofTime, 0, 0,0,None,0,0);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="4" X="200" Y="540" Operand="ServosOn" HideDesc="false" DescX="258" DescY="525" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="5" Operand="Action_009" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[counter := counter + .5;]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[IF counter >= 2.5 then]]>
</Line>
<Line Number="3">
<![CDATA[	counter := .5;]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
<Line Number="5">
<![CDATA[gear_ratio := counter;]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="6" Operand="Action_000" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MSO(axis1, axis1_MSO);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="7" Operand="Action_008" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[mso (axis0, axis0_MSO);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="8" X="160" Y="1260" Operand="Shutdown" HideDesc="false" DescX="214" DescY="1245" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="9" Operand="Action_006" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MSF(axis0, axis0_MSF);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="10" Operand="Action_003" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[msf(axis1, axis1_MSF);]]>
</Line>
</STContent>
</Body>
</Action>
<Action ID="11" Operand="Action_004" Qualifier="NonStored" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[JSR(LadderFile,0);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Step ID="12" X="160" Y="940" Operand="gear_axis0_1" HideDesc="true" DescX="214" DescY="925" DescWidth="0" InitialStep="false" PresetUsesExpr="false" LimitHighUsesExpr="false"
 LimitLowUsesExpr="false" ShowActions="true">
<Action ID="13" Operand="Action_007" Qualifier="PulseRisingEdge" IsBoolean="false" PresetUsesExpr="false">
<Body>
<STContent>
<Line Number="0">
<![CDATA[MAG (axis0, axis1, axis0_axis1_MAG, 1, gear_ratio, 1, 1, Actual, Real, Disabled, 10, 1);]]>
</Line>
</STContent>
</Body>
</Action>
</Step>
<Transition ID="14" X="200" Y="740" Operand="Tran_000" HideDesc="false" DescX="235" DescY="725" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[axis1.ServoActionStatus & axis0.ServoActionStatus]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="15" X="160" Y="1180" Operand="Tran_002" HideDesc="false" DescX="195" DescY="1165" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[axis1_MAM.PC & axis1.PositionLockStatus & input_0]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="16" X="160" Y="1400" Operand="Tran_003" HideDesc="true" DescX="195" DescY="1385" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[timer.DN]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="17" X="160" Y="1020" Operand="Tran_007" HideDesc="true" DescX="195" DescY="1005" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[axis0.GearingStatus]]>
</Line>
</STContent>
</Condition>
</Transition>
<Transition ID="18" X="200" Y="420" Operand="Tran_009" HideDesc="false" DescX="240" DescY="400" DescWidth="0">
<Condition>
<STContent>
<Line Number="0">
<![CDATA[counter = 0]]>
</Line>
</STContent>
</Condition>
</Transition>
<Branch ID="19" Y="500" BranchType="Selection" BranchFlow="Converge">
<Leg ID="20"/>
<Leg ID="21"/>
</Branch>
<DirectedLink FromID="0" ToID="18" Show="true"/>
<DirectedLink FromID="2" ToID="15" Show="true"/>
<DirectedLink FromID="4" ToID="14" Show="true"/>
<DirectedLink FromID="8" ToID="16" Show="true"/>
<DirectedLink FromID="12" ToID="17" Show="true"/>
<DirectedLink FromID="14" ToID="12" Show="false"/>
<DirectedLink FromID="15" ToID="8" Show="true"/>
<DirectedLink FromID="16" ToID="20" Show="false"/>
<DirectedLink FromID="17" ToID="2" Show="true"/>
<DirectedLink FromID="18" ToID="21" Show="true"/>
<DirectedLink FromID="19" ToID="4" Show="true"/>
<TextBox ID="22" X="60" Y="40" Width="0">
<Text>
<![CDATA[
All information provided  - No Warranty or implied merchantability. 
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes

]]>
</Text>
</TextBox>
<TextBox ID="23" X="300" Y="800" Width="0">
<Text>
<![CDATA[Transition checks that both axis are enabled
before continuing]]>
</Text>
</TextBox>
<TextBox ID="24" X="420" Y="1000" Width="0">
<Text>
<![CDATA[Executes the Gear Axis function each program loop
Uses the new gear_ratio calculated above]]>
</Text>
</TextBox>
<TextBox ID="25" X="440" Y="1360" Width="0">
<Text>
<![CDATA[Demonstrates a Jump to Subroutine called
LadderFile.  The ladder program starts a 3 sec
timer. When the timer times out the ladder directs
the program to return.  The Transition 003 check for
timer.dn bit.  If this is true the program loops back to
the Servo On step.
]]>
</Text>
</TextBox>
<TextBox ID="26" X="500" Y="540" Width="0">
<Text>
<![CDATA[Demonstrates embedded Structured Text
Automatically increments the gear_ratio by .5
for each loop of the program.  If the ratio gets
above 2 then it resets to .5 and increments up]]>
</Text>
</TextBox>
<TextBox ID="27" X="580" Y="1160" Width="0">
<Text>
<![CDATA[Executes a Move axis command on the master axis
Parameters Move_Distance and Move_Speed are tags
the user can set the value of these tags in the Monitor tags
window and change the distance and speed on the fly while 
the program is running.]]>
</Text>
</TextBox>
</SFCContent>
</Routine>
</Routines>
</Program>
</Programs>
