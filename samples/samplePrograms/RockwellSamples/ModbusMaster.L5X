<Routines>
<Routine Name="ClearBuffer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[ACL(0,Yes,Yes);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CRCLoopR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XOR(uchCRCHi,ReceiveBuffer[uLoop],uIndex)XOR(uchCRCLo,uchaCRCHi[uIndex],uchCRCHi);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(uchaCRCLo[uIndex],uchCRCLo);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CRCLoopT" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XOR(uchCRCHi,TransBuffer[uLoop],uIndex)XOR(uchCRCLo,uchaCRCHi[uIndex],uchCRCHi);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(uchaCRCLo[uIndex],uchCRCLo);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CRC_TaskR" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(0,uLoop)BTD(255,0,uchCRCLo,0,8)BTD(255,0,uchCRCHi,0,8);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SUB(recbytes,1,utransbytes)FOR(CRCLoopR,uLoop,0,utransbytes,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DataPack" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[LBL(Swap)GEQ(Lcounter2,Quantity)RET();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(writewords)SWPB(Mod_Data_HoldReg4[Lcounter1],REVERSE,DataHold[Lcounter2]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(Lcounter1,1,Lcounter1)ADD(Lcounter2,1,Lcounter2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JMP(Swap);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Decode" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[MOV(Mod_Commands[ComIndex].Enable,ActiveComm[0]) ,MOV(Mod_Commands[ComIndex].EchoReceived,ActiveComm[1]) ,MOV(Mod_Commands[ComIndex].ScanNumber,ActiveComm[2]) ,MOV(Mod_Commands[ComIndex].AddressOffsetinMaster,ActiveComm[3]) ,MOV(Mod_Commands[ComIndex].SlaveAddress,ActiveComm[4]) ,MOV(Mod_Commands[ComIndex].FunctionCode,ActiveComm[5]) ,MOV(Mod_Commands[ComIndex].StartingAddress,ActiveComm[6]) ,MOV(Mod_Commands[ComIndex].NumberofPoints,ActiveComm[7]) ,MOV(Mod_Commands[ComIndex].Spare1,ActiveComm[8]) ,MOV(Mod_Commands[ComIndex].Spare2,ActiveComm[9]) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(ActiveComm[4],TransBuffer[0]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOV(ActiveComm[5],TransBuffer[1]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],3)MOV(6,allbytes)OTE(readholdwords);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],4)MOV(6,allbytes)OTE(readinpwords);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],16)OTE(writewords);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],1)OTE(readcoils);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],2)MOV(6,allbytes)OTE(readinputs);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],15)OTE(writecoils);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],6)MOV(6,allbytes)OTE(writesinglereg);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],5)MOV(6,allbytes)OTE(writeonecoil);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(TransBuffer[1],8)COP(WordMaskS[0],TransBuffer[2],4)MOV(6,allbytes)OTE(diagnostic);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(readcoils) ,[XIC(writecoils) ,[XIC(readinputs) ,XIC(writeonecoil) ] ] ]OTE(Coils);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(writewords) ,[XIC(readholdwords) ,XIC(Coils) ,[XIC(writesinglereg) ,[XIC(readinpwords) ,XIC(diagnostic) ] ] ] ]OTE(implemented);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(implemented)OTU(ReceiverOn)OTL(noAction)RET();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Coils)DIV(ActiveComm[6],16,WordStartC)MOD(ActiveComm[6],16,BitStartC)MOV(BitStartC,ShiftbitC);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[ADD(ActiveComm[6],ActiveComm[7],EndAddr)XIC(Coils)DIV(EndAddr,16,EndWord)MOD(EndAddr,16,BitEndC);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Coils)EQU(BitStartC,0)EQU(BitEndC,0)OTE(WordBoundary);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Coils)XIO(WordBoundary)GRT(ActiveComm[7],2000)MOV(3,TransBuffer[2])OTE(bitlimit)OTL(noAction)OTU(ReceiverOn)RET();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Coils)SUB(EndWord,WordStartC,WordQuant)ADD(WordQuant,1,WordCount2);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Coils)DIV(WordCount2,2,DoubWordCount)ADD(DoubWordCount,1,DoubWordCount);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[BTD(ActiveComm[6],0,ActiveCommTemp6,0,16)SWPB(ActiveCommTemp6,REVERSE,SwappedWord)COP(SwappedWord,TransBuffer[2],2);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(writesinglereg)XIO(writeonecoil)XIO(diagnostic)[BTD(ActiveComm[7],0,ActiveCommTemp7,0,16) ,SWPB(ActiveCommTemp7,REVERSE,SwappedWord) COP(SwappedWord,TransBuffer[4],2) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIC(writewords) ,[XIC(readinpwords) ,[XIC(readholdwords) ,XIC(writesinglereg) ] ] ]ADD(ActiveComm[3],ActiveComm[6],NodeDataAdd);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
