<DataType Name="Mod_Command_Structure" Family="NoFamily" Class="User">
<Members>
<Member Name="Enable" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[0=Disabled, 1=Always Enabled, 2=ScanEnabled, 3=First Scan Only]]>
</Description>
</Member>
<Member Name="EchoReceived" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[slave answered]]>
</Description>
</Member>
<Member Name="ScanNumber" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[0 to Mod_Scan_Preset]]>
</Description>
</Member>
<Member Name="AddressOffsetinMaster" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[Index into Master Data. 0-4,095 bit or 0-65,535 registers. Always in 16 bit words.]]>
</Description>
</Member>
<Member Name="SlaveAddress" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[Node Address 0-255]]>
</Description>
</Member>
<Member Name="FunctionCode" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[1=R_Coils, 2=R_DiscInputs, 3=R_HoldReg, 4=R_InputReg, 5=W_SingleCoil, 6=W_SingleHoldReg, 15=W_MultCoils, 16=W_MultHoldReg]]>
</Description>
</Member>
<Member Name="StartingAddress" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[0-65,535 bits or registers]]>
</Description>
</Member>
<Member Name="NumberofPoints" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[1-2,000 bits or 1-120 registers (ingnored for CMDs 5 and 6)]]>
</Description>
</Member>
<Member Name="Spare1" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[unused]]>
</Description>
</Member>
<Member Name="Spare2" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false">
<Description>
<![CDATA[0 no swap,  1 swap bytes]]>
</Description>
</Member>
</Members>
