<Routine Name="WriteCoils" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(WordBoundary)COP(Mod_Data_Coils0[NodeDataAdd],TransBuffer[7],ByteCount2)RET();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[COP(Mod_Data_Coils0[NodeDataAdd],ShiftArray[0],DoubWordCount);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[SUB(ShiftbitC,1,ShiftbitC)MOV(0,ShftIndex);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GRT(ShiftbitC,0)FOR(ShiftbitRight,ShftIndex,0,ShiftbitC,1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[COP(ShiftArray[0],TransBuffer[7],ByteCount2)ADD(7,ByteCount2,allbytes);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(NonZeroBit)ADD(6,ByteCount2,TargetByte)AND(TransBuffer[TargetByte],BlankArray[Notzero2],TransBuffer[TargetByte]);]]>
</Text>
</Rung>
</RLLContent>
