</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(writesinglereg)SWPB(Mod_Data_HoldReg4[NodeDataAdd],REVERSE,SwappedWord)COP(SwappedWord,TransBuffer[4],2);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIO(Coils)MOV(ActiveComm[7],Quantity)MUL(ActiveComm[7],2,ByteCount2);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(Coils)DIV(ActiveComm[7],8,ByteCount2)MOD(ActiveComm[7],8,Notzero2);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(Coils)NEQ(Notzero2,0)ADD(ByteCount2,1,ByteCount2)OTE(NonZeroBit);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIO(writesinglereg)XIO(writeonecoil)XIO(diagnostic)BTD(ByteCount2,0,TransBuffer[6],0,8);]]>
</Text>
