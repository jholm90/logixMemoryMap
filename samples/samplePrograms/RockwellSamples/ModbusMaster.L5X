<Routine Name="IO_Scanner" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[SUB(Mod_CommdMax,1,Mod_Com_Index)LES(Mod_Cmd_Number,Mod_CommdMax)MOV(Mod_Cmd_Number,Mod_Com_Index);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[LEQ(Mod_Com_Index,0)OTL(noAction)RET();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(Mod_Scan_Preset,1,ScanCounter.PRE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LBL(Again)LEQ(Mod_Com_Index,ComIndex)MOV(0,ComIndex)CTU(ScanCounter,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(ScanCounter.DN)RES(ScanCounter);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[LBL(zeroCommand)MOV(ComIndex,ActiveIndex)OTU(noAction)OTL(ReceiverOn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Mod_Commands[ComIndex].Enable,0)COP(NullArray[1],Mod_Status[ActiveIndex].NodeAddress,6);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQU(Mod_Commands[ComIndex].Enable,0)OTU(ReceiverOn)OTL(noAction)JMP(Bypass);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(Mod_Commands[ComIndex].Enable,2)NEQ(ScanCounter.ACC,Mod_Commands[ComIndex].ScanNumber)OTU(ReceiverOn)OTL(noAction)JMP(Bypass);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(Mod_Commands[ComIndex].Enable,3)EQU(Mod_Commands[ComIndex].Enable,Mod_Commands[ComIndex].EchoReceived)ADD(100,Mod_Commands[ComIndex].FunctionCode,Mod_Status[ActiveIndex].FunctionCode)OTU(ReceiverOn)OTL(noAction)JMP(Bypass);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(noAction)JSR(Decode,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(noAction)XIO(implemented)MOV(-10,Mod_Status[ActiveIndex].FunctionCode)MOV(Mod_Commands[ActiveIndex].SlaveAddress,Mod_Status[ActiveIndex].NodeAddress)COP(NullArray[1],Mod_Status[ActiveIndex].HiStartAddr_ByteCount,4);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(noAction)XIC(implemented)MOV(-2,Mod_Status[ActiveIndex].FunctionCode)MOV(Mod_Commands[ActiveIndex].SlaveAddress,Mod_Status[ActiveIndex].NodeAddress)COP(NullArray[1],Mod_Status[ActiveIndex].HiStartAddr_ByteCount,4);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(noAction)XIC(ReceiverOn)MOV(-1,Mod_Status[ActiveIndex].FunctionCode)MOV(Mod_Commands[ActiveIndex].SlaveAddress,Mod_Status[ActiveIndex].NodeAddress);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[LBL(Bypass)ADD(ComIndex,1,ComIndex);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[GEQ(ComIndex,Mod_Status_Size)MOV(0,ComIndex)RET();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(off)CTU(ScanCounter,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(noAction)XIC(bitlimit)MOV(-2,Mod_Status[ActiveIndex].FunctionCode)OTU(bitlimit);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(noAction)LES(ComIndex,Mod_Com_Index)JMP(zeroCommand);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(noAction)GEQ(ComIndex,Mod_Com_Index)RES(Timer1)SUB(Mod_Echo_MaxTime,16,Timer1.ACC)OTU(ReceiverOn)OTE(SkipLast);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
All information provided  - No Warranty or implied merchantability. 
Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes.

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
********************************
Revision History
********************************
Release 1.0 initial release
********************************
Release 2.0.0 Modified by Commercial Engineering

Modified multiple rungs that caused arithmetic overflow minor faults, no functional change.
Improved documentation.
Modifications to allow for addressing of Coils and Registers up to 65,535. This change also increased the size of the program from about 67K to 343K. This size can be reduced if you only need to read a smaller number of Coils and Registers.
Renamed tag array Mod_DataHoldReg4 to Mod_Data_HoldReg4, no functional change.
Modified serial port User Protocol Read/Write buffer size from 140 to 280 characters.
Increased range of reads and writes to cover documented values of 1-2000 bit and 1-120 register.
Resolved multiple issues with bit reads and writes.
Removed input and output modules from I/O tree, no functional change.
********************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Mod_Active)XIO(initial)JSR(ClearBuffer,0)OTL(initial);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Mod_Active)XIC(initial)JSR(Mod_Activate,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Mod_Active)OTU(initial);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Mod_Activate" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(Mod_Echo_MaxTime,Timer1.PRE)MOV(Mod_Echo_MaxTime,MsgTimeMax);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SkipLast)MOV(5000,Timer1.ACC)OTU(SkipLast);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(Timer1.DN)TON(Timer1,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)XIC(ReceiverOn)MOV(ActiveComm[4],Mod_Status[ActiveIndex].NodeAddress)COP(NullArray[0],Mod_Status[ActiveIndex].FunctionCode,5);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)XIC(ReceiverOn)MOV(Mod_Echo_MaxTime,MsgTimeSpent)OTU(ReceiverOn);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(ReceiverOn)JSR(ReceiveMonitor,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)ACL(0,Yes,Yes)OTU(write_serial_port.EN);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)JSR(IO_Scanner,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(Timer6.DN)TON(Timer6,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Timer6.DN)MOV(Counter3.ACC,MsgCountRec)MOV(0,Counter3.ACC);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Timer6.DN)MOV(Counter6.ACC,MsgCountTrans)MOV(0,Counter6.ACC);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)XIO(noAction)CTU(Counter6,?,?)MOV(allbytes,write_serial_port.LEN);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(noAction)COP(NullArray[1],Mod_Status[ActiveIndex].HiStartAddr_ByteCount,4);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)XIO(write_serial_port.EN)XIO(noAction)AWT(0,TransBuffer[0],write_serial_port,?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)XIO(noAction)OTL(ReceiverOn);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Timer1.DN)RES(Timer1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReadCoils_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(WordBoundary)[XIC(readcoils) ,XIC(readinputs) ]ADD(WordStartC,ActiveComm[3],WordStartC2)SUB(WordCount2,1,WordCount2);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(WordBoundary)XIC(readinputs)COP(ReceiveBuffer[3],Mod_Data_Contacts1[WordStartC2],WordCount2)RET();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(WordBoundary)XIC(readcoils)COP(ReceiveBuffer[3],Mod_Data_Coils0[WordStartC2],WordCount2)RET();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[COP(ReceiveBuffer[3],ShiftArray[0],DoubWordCount);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[ADD(WordStartC,ActiveComm[3],WordStartC2)ADD(EndWord,ActiveComm[3],EndWord2)MOV(0,ShftIndex);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SUB(BitStartC,1,ShiftbitC)GEQ(ShiftbitC,0)FOR(ShiftbitLeft,ShftIndex,0,ShiftbitC,1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[COP(ShiftArray[0],TestArray[0],WordCount2);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[This rung does a read/modify/write of Coils0 to TestArray so that you can write to individual bits in the Coils0 file. Bit 15 is not done through the MVM because if using an MVM with an indirectly addressed Dest, if the Dest starts out positive and after the MVM is executed ends up negative an arithmetic overflow will occur and cause a minor fault.]]>
</Comment>
<Text>
<![CDATA[XIC(readcoils)[MVM(Mod_Data_Coils0[WordStartC2],WordMaskS[BitStartC],TestArray[0]) MVM(Mod_Data_Coils0[EndWord2],WordMaskE[BitEndC],TestArray[WordQuant]) ,[XIC(Mod_Data_Coils0[EndWord2].15) OTL(TestArray[WordQuant].15) ,XIO(Mod_Data_Coils0[EndWord2].15) OTU(TestArray[WordQuant].15) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[This rung does a read/modify/write of Contacts1 to TestArray so that you can write to individual bits in the Contacts1 file. Bit 15 is not done through the MVM because if using an MVM with an indirectly addressed Dest, if the Dest starts out positive and after the MVM is executed ends up negative an arithmetic overflow will occur and cause a minor fault.]]>
</Comment>
<Text>
<![CDATA[XIC(readinputs)[MVM(Mod_Data_Contacts1[WordStartC2],WordMaskS[BitStartC],TestArray[0]) MVM(Mod_Data_Contacts1[EndWord2],WordMaskE[BitEndC],TestArray[WordQuant]) ,[XIC(Mod_Data_Contacts1[EndWord2].15) OTL(TestArray[WordQuant].15) ,XIO(Mod_Data_Contacts1[EndWord2].15) OTU(TestArray[WordQuant].15) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(readcoils)COP(TestArray[0],Mod_Data_Coils0[WordStartC2],WordCount2);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(readinputs)COP(TestArray[0],Mod_Data_Contacts1[WordStartC2],WordCount2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReadReg_Inputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[COP(ReceiveBuffer[3],Swapbuffer[0],Quantity);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(0,Lcounter1)MOV(0,Lcounter2);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LBL(SwapFill)GEQ(Lcounter2,Quantity)RET();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ADD(NodeDataAdd,Lcounter2,TableAddr);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GEQ(TableAddr,Mod_Data_Array_Max)RET();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(readinpwords)SWPB(Swapbuffer[Lcounter1],REVERSE,Mod_Data_InpReg3[TableAddr]);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(readholdwords)SWPB(Swapbuffer[Lcounter1],REVERSE,Mod_Data_HoldReg4[TableAddr]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ADD(Lcounter1,1,Lcounter1)ADD(Lcounter2,1,Lcounter2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JMP(SwapFill);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ReceiveMonitor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(off)ACL(0,Yes,No);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(Hold3,Hold4)MOV(CharCo.POS,Hold3);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(CharCo.EN)ACB(0,CharCo,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GEQ(CharCo.POS,3)LEQ(CharCo.POS,Hold4)XIC(CharCo.DN)OTE(Store2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GRT(CharCo.POS,maxCount1)MOV(CharCo.POS,maxCount1);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Store2)MOV(CharCo.POS,read_serial_port.LEN);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Store2)XIO(read_serial_port.EN)ARD(0,ReceiveBuffer[0],read_serial_port,?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(read_serial_port.DN)SUB(read_serial_port.LEN,2,recbytes);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(read_serial_port.DN)OSR(Node_there1,Node_there2);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Node_there2)CTU(Counter3,?,?)ACL(0,Yes,No);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Node_there2)MOV(Timer1.ACC,MsgTimeSpent)MOV(TimeReset,Timer1.ACC)JSR(CRC_TaskR,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Node_there2)MOV(recbytes,crcload2)ADD(crcload2,1,crchiad2);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(ReceiveBuffer[crcload2],uchCRCHi)EQU(ReceiveBuffer[crchiad2],uchCRCLo)OTE(CRCgood);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIO(CRCgood)OTU(ReceiverOn)ACL(0,Yes,No)RET();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIC(CRCgood)COP(ReceiveBuffer[0],Mod_Status[ActiveIndex].NodeAddress,6);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIC(CRCgood)LEQ(ReceiveBuffer[1],0)OTE(BadFunctCode);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIO(BadFunctCode)XIC(CRCgood)[XIC(readcoils) ,XIC(readinputs) ]JSR(ReadCoils_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIO(BadFunctCode)XIC(CRCgood)[XIC(readholdwords) ,XIC(readinpwords) ]JSR(ReadReg_Inputs,0);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(Node_there2)MOV(0,CharCo.POS)OTU(read_serial_port.EN);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(Node_there2)XIO(noAction)XIO(BadFunctCode)MOV(Mod_Commands[ActiveIndex].Enable,Mod_Commands[ActiveIndex].EchoReceived);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Node_there2)OTU(ReceiverOn)ACL(0,Yes,No);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftbitLeft" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[RES(ShftArry);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[BSL(ShiftArray[0],ShftArry,off,?);]]>
</Text>
