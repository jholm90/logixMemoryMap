<![CDATA[XIC(Coils)ADD(ActiveComm[3],WordStartC,NodeDataAdd);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[LES(NodeDataAdd,0)OTL(bitlimit)OTL(noAction)OTU(ReceiverOn)RET();]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIO(diagnostic)GEQ(NodeDataAdd,Mod_Data_Array_Max)OTL(noAction)OTU(ReceiverOn)RET();]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Coils)XIO(writeonecoil)ADD(NodeDataAdd,WordCount2,ArrayEnd);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIO(Coils)ADD(NodeDataAdd,ActiveComm[7],ArrayEnd);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(diagnostic)GEQ(ArrayEnd,Mod_Data_Array_Max)OTL(noAction)OTU(ReceiverOn)RET();]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(writeonecoil)AND(Mod_Data_Coils0[NodeDataAdd],BitMask[BitStartC],Temp)COP(Constant0000,TransBuffer[4],2)NEQ(Temp,0)BTD(255,0,TransBuffer[4],0,8);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[[XIC(writesinglereg) ,XIC(writeonecoil) ]MOV(6,allbytes);]]>
